# Root Compose settings for the local stack (make up); make env copies this
# file to .env.compose.

# Forge web console
WEB_PORT=18190

# API base URL baked into the web bundle at build time
# (import.meta.env.VITE_API_URL): the admin API published on ADMIN_PORT.
VITE_API_URL=http://localhost:18201/api/v1
# Local development only: the admin API bearer token the web console signs in
# with, also baked into the bundle. make web-token sets it.
VITE_API_TOKEN=

# Admin API and MySQL. Shared MongoDB/Redis ports and credentials live in
# .env.common (FORGE_MONGO_* / FORGE_REDIS_PORT).
# Atlas Local hostname (also its replica-set name). For existing volumes,
# set this to the saved rs.conf()._id; changing it prevents startup.
FORGE_MONGO_HOSTNAME=mongo
ADMIN_PORT=18201
ADMIN_MYSQL_PORT=13326

# Async worker: runs ADK workflows off shared Redis database 0, each run kept
# in the admin MySQL. Worker settings, including API keys, live in
# apps/forge-async-worker/.env.
# Container overrides (defaults in apps/forge-async-worker/compose.yaml): the
# adk_workflows queue's concurrency and replicas.
#ASYNC_WORKER_ADK_WORKFLOWS_CONCURRENCY=8
#ASYNC_WORKER_ADK_WORKFLOWS_REPLICAS=1
#ASYNC_WORKER_STOP_GRACE_PERIOD=1m

# Code graph ingestion worker: its health probes and admission API on
# http://localhost:18090, and the Spanner emulator it writes the graph to
# (in memory: make down loses it). Worker settings live in
# apps/forge-codegraph-worker/.env; these override them in the container
# (defaults in apps/forge-codegraph-worker/compose.yaml).
WORKER_HEALTH_PORT=18090
WORKER_STOP_GRACE_PERIOD=1m
#WORKER_BUILD_MODE=maven-resolved
#WORKER_LANGUAGES='{"java":{...},"typescript":{},"python":{}}'
#WORKER_TIMEOUT=2h
#WORKER_STARTUP_TIMEOUT=60s
#WORKER_QUEUE=ingestion
#WORKER_SPANNER_DATABASE=projects/codegraph-local/instances/codegraph/databases/codegraph
#WORKER_SCOPE=codegraph
SPANNER_GRPC_PORT=19030
SPANNER_HTTP_PORT=19040
SPANNER_MEMORY_LIMIT=4g
SPANNER_CPUS=4
# Managed Cloud Spanner for the worker instead of the emulator, so graphs
# outlive make down (make worker SPANNER=cloud, make up SPANNER=cloud): the
# database, which make worker-spanner-cloud creates with the codegraph schema
# in an existing instance, and for Compose a service account key that can
# read and write it. Natively the worker uses your gcloud credentials
# (gcloud auth application-default login).
#WORKER_CLOUD_SPANNER_DATABASE=projects/<project>/instances/<instance>/databases/codegraph
#CLOUD_SPANNER_KEY_FILE=./.secrets/spanner-sa.json

# Code graph MCP server: the graph's tools on http://localhost:18203/mcp,
# reading the worker's database (WORKER_SPANNER_DATABASE, WORKER_SCOPE).
# Settings live in apps/forge-codegraph-mcp/.env; these override them in the
# container (defaults in apps/forge-codegraph-mcp/compose.yaml).
CODEGRAPH_MCP_PORT=18203
#CODEGRAPH_MCP_STOP_GRACE_PERIOD=30s
#CODEGRAPH_MCP_SEARCH_ENHANCE_QUERY=false
