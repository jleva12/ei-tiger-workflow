# forge-async-worker configuration: HYBRID_* settings, nested with __. The
# worker's own are in src/forge_async_worker/config.py; each task package reads
# its own section (packages/python/adk-workflows/src/forge_task_adk_workflows/config.py).
# make env copies this to .env; keep real credentials out of this template.
# Precedence, lowest to highest: built-in defaults, .env in the working
# directory, the process environment. Values the worker shares with other apps
# (the Redis the admin queues runs on, the MySQL connection and the model
# keys) come from the repository's .env.common, which make env creates, by
# ${NAME} reference: an earlier line of this file wins, and only the names
# referenced here are read (forge_tasks.env_files). Compose resolves the
# references, passes .env to the containers and overrides the Redis and MySQL
# settings to reach its services.

# Task types the worker builds, from the installed task packages. It serves
# each one's queue: adk_workflows (ADK workflow runs) and documents
# (knowledge base documents); --queues picks some.
HYBRID_ENABLED_TASKS='["adk_workflows","documents"]'

# The SAQ queues (adk_workflows, documents) use database 0 of the shared
# Redis, where the admin API queues jobs too.
HYBRID_REDIS_URL=${FORGE_REDIS_URL}

# Logging (forge_common.logging): every logger, the worker's, SAQ's, the task
# packages' and the libraries', as one structured format.
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
HYBRID_LOGGING__LEVEL=INFO
# json (one object per line, for log collectors) or console (key=value).
# Unset, console on a terminal and json otherwise (containers, pipes).
HYBRID_LOGGING__FORMAT=console
# Colors in the console format. Unset, on for a terminal or FORCE_COLOR
# and off for NO_COLOR; true colors piped output too (the Claude app's
# or an IDE's run panel, make up-all-local).
HYBRID_LOGGING__COLORS=true
# Replaces the default per-logger levels (httpx, httpx2, httpcore and
# watchfiles at WARNING):
#HYBRID_LOGGING__LEVELS='{"httpx":"WARNING","saq":"DEBUG"}'

# adk_workflows task: runs of organizations' ADK workflows (the ADK workflows
# page of the web console), submitted by the admin API to the adk_workflows
# queue, run on Google ADK's graph engine.
# Runs live in the admin MySQL: the run store (adk_runs and adk_run_events,
# which the admin API's migrations create), where the admin API starts, lists
# and acts on them, and each run's ADK session (ADK's DatabaseSessionService
# creates its tables on first use), where it reads a run's steps. The admin's
# own connection, from .env.common (a password with URL-reserved characters
# must be percent-encoded here). Compose points it at admin-mysql. Unset, the
# worker won't start.
HYBRID_ADK_WORKFLOWS__SESSION_DATABASE_URL=mysql+aiomysql://${FORGE_MYSQL_USER}:${FORGE_MYSQL_PASSWORD}@${FORGE_MYSQL_HOST}:${FORGE_MYSQL_PORT}/${FORGE_MYSQL_DATABASE}
# LLM nodes run on the models of the model-provider YAML the admin API's
# assistant reads (packages/python/common/src/forge_common/model_provider),
# when this names it: a node picks one (the builder lists them) and how long
# it thinks. Its ${NAME} references resolve from the process environment,
# then from this file, so reference the keys its providers need here too.
# Without it, Gemini with the shared key; neither, LLM nodes fail the run.
HYBRID_ADK_WORKFLOWS__GOOGLE_API_KEY=${FORGE_GOOGLE_API_KEY}
# model_provider.openai.yaml offers OpenAI's and Anthropic's (Claude) models:
# HYBRID_ADK_WORKFLOWS__MODEL_PROVIDER_CONFIG=../../packages/python/common/src/forge_common/model_provider/model_provider.openai.yaml
# OPENAI_API_KEY=${OPENAI_API_KEY}
# ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
# OPENAI_MODEL=gpt-5.2
# The model a node that picks none runs on: the YAML's default, or else
# gemini-3.5-flash; and how long one model call may take (seconds).
#HYBRID_ADK_WORKFLOWS__DEFAULT_MODEL=gemini-3.5-flash
#HYBRID_ADK_WORKFLOWS__MODEL_TIMEOUT=180
# HTTP nodes never reach private or loopback addresses unless allowed; hosts
# listed here (a JSON array) are always allowed.
#HYBRID_ADK_WORKFLOWS__HTTP_ALLOW_PRIVATE=false
#HYBRID_ADK_WORKFLOWS__HTTP_ALLOWED_HOSTS='["api.example.com"]'
#HYBRID_ADK_WORKFLOWS__HTTP_MAX_RESPONSE_BYTES=5242880
# Delays up to this many seconds wait in place; longer ones pause the run and
# let the worker go until their time. The most items one loop goes through.
#HYBRID_ADK_WORKFLOWS__INLINE_DELAY_SECONDS=20
#HYBRID_ADK_WORKFLOWS__MAX_LOOP_ITEMS=10000
# The most seconds a run goes on at a time (from its start or an answer, to
# its end or next pause) before it fails.
#HYBRID_ADK_WORKFLOWS__RUN_TIMEOUT=3600
# LLM agents' tools (the Agents builder's): the organization's MCP servers
# are connected with their credentials, encrypted with the admin API's
# FORGE_ADMIN_SECRETS_KEY; make env copies it here. ${NAME}s in HTTP tools'
# URLs and headers come from this worker's environment. A workflow an agent
# calls as a tool is waited for this many seconds.
HYBRID_ADK_WORKFLOWS__SECRETS_KEY=
#HYBRID_ADK_WORKFLOWS__WORKFLOW_TOOL_WAIT=120
# Knowledge base tools searching a graph knowledge base (code repositories)
# search the code graph worker's API (make worker; its CODEGRAPH_HEALTH_ADDR)
# with its token from .env.common. Empty, such a search fails saying so.
HYBRID_ADK_WORKFLOWS__CODEGRAPH_URL=http://127.0.0.1:8090
HYBRID_ADK_WORKFLOWS__CODEGRAPH_TOKEN=${FORGE_CODEGRAPH_ADMISSION_TOKEN}

# documents task: knowledge base documents (the Knowledge bases page),
# submitted by the admin API to the documents queue with where it stored them
# (s3://). Each is parsed (PDF, Word, PowerPoint, Excel, CSV, Markdown, text,
# Visio, Mermaid), chunked, embedded and stored for hybrid search (Atlas
# Search BM25 and Vector Search) in this MongoDB database, whose indexes
# worker --ensure-schema creates. The admin API searches the same database
# (FORGE_ADMIN_KNOWLEDGE_DATABASE), embedding queries with the same model.
HYBRID_MONGO__URI=${FORGE_MONGO_URI}
HYBRID_MONGO__DATABASE=${FORGE_KNOWLEDGE_DATABASE}
# Where the uploads are: the RustFS of make infrastructure locally.
HYBRID_S3__ENDPOINT_URL=${FORGE_S3_ENDPOINT_URL}
HYBRID_S3__REGION=us-east-1
HYBRID_S3__ACCESS_KEY_ID=${FORGE_S3_ACCESS_KEY_ID}
HYBRID_S3__SECRET_ACCESS_KEY=${FORGE_S3_SECRET_ACCESS_KEY}
# The embedding model: the one every app embeds with (FORGE_EMBEDDING_* in
# .env.common), so the admin API's searches, which embed with the same, match
# the chunks. OpenAI's API (an OpenAI-compatible gateway with the base URL).
HYBRID_EMBEDDING__PROVIDER=openai
HYBRID_EMBEDDING__API_KEY=${OPENAI_API_KEY}
HYBRID_EMBEDDING__DOCUMENT_MODEL=${FORGE_EMBEDDING_MODEL}
HYBRID_EMBEDDING__DIMENSIONS=${FORGE_EMBEDDING_DIMENSIONS}
HYBRID_EMBEDDING__BASE_URL=${FORGE_EMBEDDING_BASE_URL}
# Chunk size in tokens; OCR of scanned PDF pages with Tesseract when it's
# installed; LibreOffice (soffice) converts .doc, .ppt, .xls and OpenDocument.
#HYBRID_DOCUMENTS__CHUNKING__MAX_TOKENS=400
#HYBRID_DOCUMENTS__OCR__ENABLED=true
#HYBRID_DOCUMENTS__OFFICE__ENABLED=true
# One LLM call per chunk to situate it in its document (contextual
# retrieval): better recall, more cost. Off by default.
#HYBRID_DOCUMENTS__CONTEXT__ENABLED=false
#HYBRID_LLM__PROVIDER=anthropic
#HYBRID_LLM__API_KEY=${ANTHROPIC_API_KEY}
