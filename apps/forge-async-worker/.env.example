# forge-async-worker configuration: HYBRID_* settings, nested with __. The
# worker's own are in src/forge_async_worker/config.py; each task package reads
# its own section (packages/python/tasks/*/src/*/config.py).
# make env copies this to .env; keep real credentials out of this template.
# Precedence, lowest to highest: built-in defaults, .env in the working
# directory, the process environment. Values the worker shares with other apps
# (the Redis the admin submits to, the MongoDB connection, the tokens and the
# model keys) come from the repository's .env.common, which make env creates,
# by ${NAME} reference: an earlier line of this file wins, and only the names
# referenced here are read (forge_tasks.env_files). Compose resolves the
# references, passes .env to the containers and overrides the MongoDB and
# Redis settings to reach its services.

# Task types the worker builds, from the installed task packages; each has its
# own SAQ queue of the same name. A deployment serves some of their queues
# (forge-async-worker worker --queues ...).
HYBRID_ENABLED_TASKS='["workflows","adk_workflows"]'

# Shared MongoDB Atlas Local. The connection lives in .env.common.
HYBRID_MONGO__URI=${FORGE_MONGO_URI}

# The SAQ job queues and locks use database 0 of the shared Redis,
# where the admin submits jobs too.
HYBRID_REDIS_URL=${FORGE_REDIS_URL}

# Every job is a run tracked by the enhanced task framework: runs, steps and
# the audit trail in this database on HYBRID_MONGO__URI, with Mongo leases.
# "memory" keeps them in the process (tests, one-off runs). Every queue's
# worker also sweeps for runs whose worker died (untouched this long, their
# lease free) and re-drives them, and expires overdue approvals.
HYBRID_ETF__STORE=mongo
HYBRID_ETF__DATABASE=forge_tasks
#HYBRID_ETF__STALE_AFTER_SECONDS=900
#HYBRID_ETF__MAINTENANCE_CRON='*/5 * * * *'

# The background tasks API (forge-async-worker api; make async-worker-api):
# what the task framework recorded of each organization's tasks, and resubmitting,
# restarting and abandoning one, for the admin API, which calls it with this
# token (FORGE_ASYNC_WORKER_TOKEN in .env.common, which make env generates).
HYBRID_API__TOKEN=${FORGE_ASYNC_WORKER_TOKEN}
HYBRID_API__PORT=8104

# Logging (forge_common.logging): every logger, the worker's, SAQ's, the task
# packages' and the libraries', as one structured format. The background tasks
# API adds one access line per request; each request's lines carry its
# request_id, which the response's X-Request-ID header returns.
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
HYBRID_LOGGING__LEVEL=INFO
# json (one object per line, for log collectors) or console (key=value).
# Unset, console on a terminal and json otherwise (containers, pipes).
HYBRID_LOGGING__FORMAT=console
HYBRID_LOGGING__ACCESS_LOG=true
# Replaces the default per-logger levels (httpx, httpx2, httpcore and
# watchfiles at WARNING):
#HYBRID_LOGGING__LEVELS='{"httpx":"WARNING","saq":"DEBUG"}'

# workflows task: runs of organizations' workflows (the builder in the web
# console), submitted by the admin API. Run-workflow steps start other
# workflows as the member a run acts as, through the admin API's service routes
# (make admin listens on 8101; Compose points the worker at
# http://admin:8091), with FORGE_WORKFLOWS_TOKEN from .env.common. The worker
# holds no one's tokens. Agent steps run on the models of the model-provider
# YAML the admin API's assistant reads (packages/python/common/src/
# forge_common/model_provider), when HYBRID_WORKFLOWS__MODEL_PROVIDER_CONFIG
# names it: a step picks one (the builder lists them) and how long it thinks.
# Its ${NAME} references resolve from the process environment, then from this
# file, so reference the keys its providers need here too. Without it, agent
# steps run on Gemini with the shared key.
HYBRID_WORKFLOWS__ADMIN_URL=http://127.0.0.1:8101
HYBRID_WORKFLOWS__ADMIN_TOKEN=${FORGE_WORKFLOWS_TOKEN}
HYBRID_WORKFLOWS__GOOGLE_API_KEY=${FORGE_GOOGLE_API_KEY}
# model_provider.openai.yaml offers OpenAI's and Anthropic's (Claude) models:
# HYBRID_WORKFLOWS__MODEL_PROVIDER_CONFIG=../../packages/python/common/src/forge_common/model_provider/model_provider.openai.yaml
# OPENAI_API_KEY=${OPENAI_API_KEY}
# ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
# OPENAI_MODEL=gpt-5.2
# The model a step that picks none runs on: the YAML's default, or else
# gemini-3.5-flash.
#HYBRID_WORKFLOWS__AGENT_MODEL=gemini-3.5-flash
# HTTP steps never reach private or loopback addresses unless allowed; hosts
# listed here (a JSON array) are always allowed.
#HYBRID_WORKFLOWS__HTTP_ALLOWED_HOSTS='["api.example.com"]'

# adk_workflows task: runs of organizations' ADK workflows (the ADK workflows
# page of the web console), submitted by the admin API to the adk_workflows
# queue, run on Google ADK's graph engine. Apart from the workflows task: none
# of the HYBRID_WORKFLOWS__* settings apply to it.
# A run's state is its ADK session, kept in the admin MySQL (ADK's
# DatabaseSessionService creates its tables there on first use), where the
# admin API reads a run's steps: the admin's own connection, from .env.common
# (a password with URL-reserved characters must be percent-encoded here).
# Compose points it at admin-mysql. Unset, runs fail saying so.
HYBRID_ADK_WORKFLOWS__SESSION_DATABASE_URL=mysql+aiomysql://${FORGE_MYSQL_USER}:${FORGE_MYSQL_PASSWORD}@${FORGE_MYSQL_HOST}:${FORGE_MYSQL_PORT}/${FORGE_MYSQL_DATABASE}
# LLM nodes run on the models of the model-provider YAML (as the workflows
# task's agent steps do), when this names it: a node picks one and how long it
# thinks. Its ${NAME} references (OPENAI_API_KEY, ANTHROPIC_API_KEY,
# OPENAI_MODEL above) resolve from the process environment, then this file.
# Without it, Gemini with the shared key; neither, LLM nodes fail the run.
HYBRID_ADK_WORKFLOWS__GOOGLE_API_KEY=${FORGE_GOOGLE_API_KEY}
# HYBRID_ADK_WORKFLOWS__MODEL_PROVIDER_CONFIG=../../packages/python/common/src/forge_common/model_provider/model_provider.openai.yaml
# The model a node that picks none runs on: the YAML's default, or else
# gemini-3.5-flash; and how long one model call may take (seconds).
#HYBRID_ADK_WORKFLOWS__DEFAULT_MODEL=gemini-3.5-flash
#HYBRID_ADK_WORKFLOWS__MODEL_TIMEOUT=180
# HTTP nodes never reach private or loopback addresses unless allowed; hosts
# listed here (a JSON array) are always allowed.
#HYBRID_ADK_WORKFLOWS__HTTP_ALLOW_PRIVATE=false
#HYBRID_ADK_WORKFLOWS__HTTP_ALLOWED_HOSTS='["api.example.com"]'
#HYBRID_ADK_WORKFLOWS__HTTP_MAX_RESPONSE_BYTES=5242880
# Delays up to this many seconds wait in place; longer ones pause the run and
# let the worker go until their time. The most items one loop goes through.
#HYBRID_ADK_WORKFLOWS__INLINE_DELAY_SECONDS=20
#HYBRID_ADK_WORKFLOWS__MAX_LOOP_ITEMS=10000
# The most seconds a run goes on at a time (from its start or an answer, to
# its end or next pause) before it fails.
#HYBRID_ADK_WORKFLOWS__RUN_TIMEOUT=3600
