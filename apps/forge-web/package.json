{
  "name": "@forge/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --pretty false",
    "test:workflows": "node --test tests/workflow-expressions.test.mjs tests/workflow-layout.test.mjs tests/workflow-builder-store.test.mjs tests/workflow-runs.test.mjs",
    "test:agents": "node --test tests/agent-*.test.mjs",
    "test:timestamps": "node --test tests/timestamps.test.mjs",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run check:workflow-schema && npm run check:agent-schema",
    "generate:workflow-schema": "node scripts/generate-workflow-schema.mjs",
    "check:workflow-schema": "node scripts/generate-workflow-schema.mjs --check",
    "generate:agent-schema": "node scripts/generate-agent-schema.mjs",
    "check:agent-schema": "node scripts/generate-agent-schema.mjs --check"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.22",
    "@assistant-ui/react-google-adk": "^0.0.32",
    "@assistant-ui/react-markdown": "^0.14.17",
    "@base-ui/react": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lezer/highlight": "^1.2.4",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.12.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "jsonata": "^2.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
