{
  "name": "@forge/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:desktop": "vite --config vite.desktop.config.ts",
    "build:desktop": "tsc -b && vite build --config vite.desktop.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --pretty false",
    "test:steps": "node --test tests/steps-expressions.test.mjs tests/builder-layout.test.mjs tests/runs.test.mjs tests/run-trace.test.mjs",
    "test:agents": "node --test tests/agent-*.test.mjs",
    "test:timestamps": "node --test tests/timestamps.test.mjs",
    "test:overview": "node --test tests/overview.test.mjs tests/overview-dashboard.test.mjs tests/overview-custom-widget.test.mjs tests/overview-view.test.mjs",
    "test:assistant": "node --test tests/assistant-*.test.mjs",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run check:agent-schema",
    "generate:agent-schema": "node scripts/generate-agent-schema.mjs",
    "check:agent-schema": "node scripts/generate-agent-schema.mjs --check"
  },
