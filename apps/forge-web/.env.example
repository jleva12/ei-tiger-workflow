# Copy to .env.local for local development; it is ignored by Git and Docker.

# Base URL of the backend API. Vite inlines it into the bundle, so never put
# credentials here. make admin serves the admin API here. /api/v1 works too:
# the dev server forwards /api and /health to the admin API (API_PROXY_TARGET,
# default http://localhost:8101), which is what makes the console work through
# a tunnel such as ngrok, from another device.
VITE_API_URL=http://localhost:8101/api/v1
#API_PROXY_TARGET=http://localhost:8101

# Local development only: the bearer token the web console sends the admin API,
# which signs you in as the seeded site administrator. make web-token sets it.
# Like every VITE_ variable it is inlined into the bundle: never build a
# deployable bundle with it set.
VITE_API_TOKEN=

# GitHub token for the private @forge-ui shadcn registry in components.json.
# Only the shadcn CLI reads it (npx shadcn add @forge-ui/<item>); it is not a
# VITE_ variable and never reaches the browser.
FORGE_UI_TOKEN=

# The assistant (bottom-right on every page) talks to the Forge agent, which
# the admin API serves at VITE_API_URL/agents in the Google ADK API server's
# protocol; leave VITE_ADK_URL empty for it. Set it only to use another ADK
# agent server instead, as a full URL (`adk api_server`: http://localhost:8000);
# a path like "agents" resolves against the page, not the API. VITE_ADK_APP is
# the agent's app name on that server (the admin API's is forge).
VITE_ADK_URL=
VITE_ADK_APP=forge
