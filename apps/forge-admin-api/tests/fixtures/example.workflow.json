{
  "format": "forge.workflow/v1",
  "id": "wf_ndwlursri0",
  "name": "Review purchase requests",
  "description": "Example: an agent assesses a purchase request against the vendor's record; large or risky purchases go to an organization admin to approve, small ones wait for the next ordering window, and approved ones are ordered. Start it with a request, or link it to an event type on Events.",
  "organization_id": "00000000-0000-0000-0000-000000000000",
  "entry": "start",
  "nodes": [
    {
      "id": "start",
      "kind": "entry",
      "name": "Start",
      "config": {
        "trigger": "manual",
        "event_types": [],
        "cron": "0 9 * * 1-5",
        "timezone": "UTC",
        "input_schema": {
          "type": "object",
          "required": [
            "request"
          ],
          "properties": {
            "request": {
              "type": "object",
              "required": [
                "id",
                "item",
                "amount",
                "vendor"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The request's reference, e.g. PR-1042."
                },
                "requester": {
                  "type": "string",
                  "description": "Who asks for it."
                },
                "item": {
                  "type": "string",
                  "description": "What they want to buy."
                },
                "amount": {
                  "type": "number",
                  "description": "What it costs, in dollars."
                },
                "vendor": {
                  "type": "string",
                  "description": "The vendor's ID."
                },
                "justification": {
                  "type": "string",
                  "description": "Why it's needed."
                }
              }
            }
          }
        }
      },
      "outputs": [
        "next"
      ]
    },
    {
      "id": "vendor",
      "kind": "http",
      "name": "Look up the vendor",
      "config": {
        "method": "GET",
        "url": "https://api.example.com/vendors/{{ input.request.vendor }}",
        "headers": [],
        "body": "",
        "timeout_seconds": 30,
        "retries": 0,
        "output_schema": {}
      },
      "outputs": [
        "success",
        "error"
      ]
    },
    {
      "id": "assess",
      "kind": "agent",
      "name": "Assess the request",
      "config": {
        "instructions": "Read the purchase request and the vendor's record. Say what the spend is for, whether it fits the justification, and how risky it is.",
        "model": {
          "provider": "",
          "name": ""
        },
        "thinking_level": "",
        "output": "json",
        "output_schema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"category\",\n    \"risk\",\n    \"summary\"\n  ],\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\"\n    },\n    \"risk\": {\n      \"enum\": [\n        \"low\",\n        \"high\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    }\n  }\n}"
      },
      "outputs": [
        "next"
      ]
    },
    {
      "id": "route",
      "kind": "match",
      "name": "Route by size and risk",
      "config": {
        "arms": [
          {
            "id": "large",
            "label": "Large purchase",
            "condition": "input.request.amount > 10000"
          },
          {
            "id": "risky",
            "label": "Risky",
            "condition": "steps.assess.output.risk = \"high\""
          }
        ]
      },
      "outputs": [
        "large",
        "risky",
        "otherwise"
      ]
    },
    {
      "id": "window",
      "kind": "delay",
      "name": "Wait for the ordering window",
      "config": {
        "amount": 2,
        "unit": "hours"
      },
      "outputs": [
        "next"
      ]
    },
    {
      "id": "review",
      "kind": "approval",
      "name": "An admin approves the purchase",
      "config": {
        "message": "{{ input.request.requester }} asks to buy {{ input.request.item }} for {{ input.request.amount }} dollars from {{ input.request.vendor }}. {{ steps.assess.output.summary }} Approve the purchase?",
        "approvers": "org:admin",
        "timeout_hours": 48
      },
      "outputs": [
        "approved",
        "rejected"
      ]
    },
    {
      "id": "place_order",
      "kind": "http",
      "name": "Place the order",
      "config": {
        "method": "POST",
        "url": "https://api.example.com/purchase-orders",
        "headers": [
          {
            "id": "h_ct",
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\n  \"request\": input.request.id,\n  \"vendor\": input.request.vendor,\n  \"item\": input.request.item,\n  \"amount\": input.request.amount\n}",
        "timeout_seconds": 30,
        "retries": 0,
        "output_schema": {}
      },
      "outputs": [
        "success",
        "error"
      ]
    },
    {
      "id": "confirm",
      "kind": "transform",
      "name": "Sum up the order",
      "config": {
        "expression": "{\n  \"order\": steps.place_order.output.body.id,\n  \"category\": steps.assess.output.category\n}",
        "output_schema": {}
      },
      "outputs": [
        "next"
      ]
    },
    {
      "id": "ordered",
      "kind": "end",
      "name": "Ordered",
      "config": {
        "outcome": "succeeded",
        "result": "steps.confirm.output"
      },
      "outputs": []
    },
    {
      "id": "tell_requester",
      "kind": "http",
      "name": "Tell the requester",
      "config": {
        "method": "POST",
        "url": "https://hooks.example.com/procurement/declined",
        "headers": [
          {
            "id": "h_ct",
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\n  \"request\": input.request.id,\n  \"comment\": steps.review.output.comment\n}",
        "timeout_seconds": 30,
        "retries": 0,
        "output_schema": {}
      },
      "outputs": [
        "success",
        "error"
      ]
    },
    {
      "id": "declined",
      "kind": "end",
      "name": "Declined",
      "config": {
        "outcome": "failed",
        "result": "steps.review.output"
      },
      "outputs": []
    },
    {
      "id": "unknown_vendor",
      "kind": "end",
      "name": "Unknown vendor",
      "config": {
        "outcome": "failed",
        "result": "\"The vendor isn't on file: \" & input.request.vendor"
      },
      "outputs": []
    }
  ],
  "edges": [
    {
      "id": "start:next->vendor",
      "source": "start",
      "source_output": "next",
      "target": "vendor"
    },
    {
      "id": "vendor:success->assess",
      "source": "vendor",
      "source_output": "success",
      "target": "assess"
    },
    {
      "id": "vendor:error->unknown_vendor",
      "source": "vendor",
      "source_output": "error",
      "target": "unknown_vendor"
    },
    {
      "id": "assess:next->route",
      "source": "assess",
      "source_output": "next",
      "target": "route"
    },
    {
      "id": "route:large->review",
      "source": "route",
      "source_output": "large",
      "target": "review"
    },
    {
      "id": "route:risky->review",
      "source": "route",
      "source_output": "risky",
      "target": "review"
    },
    {
      "id": "route:otherwise->window",
      "source": "route",
      "source_output": "otherwise",
      "target": "window"
    },
    {
      "id": "window:next->place_order",
      "source": "window",
      "source_output": "next",
      "target": "place_order"
    },
    {
      "id": "review:approved->place_order",
      "source": "review",
      "source_output": "approved",
      "target": "place_order"
    },
    {
      "id": "review:rejected->tell_requester",
      "source": "review",
      "source_output": "rejected",
      "target": "tell_requester"
    },
    {
      "id": "tell_requester:success->declined",
      "source": "tell_requester",
      "source_output": "success",
      "target": "declined"
    },
    {
      "id": "place_order:success->confirm",
      "source": "place_order",
      "source_output": "success",
      "target": "confirm"
    },
    {
      "id": "confirm:next->ordered",
      "source": "confirm",
      "source_output": "next",
      "target": "ordered"
    }
  ],
  "layout": {
    "start": {
      "x": 0,
      "y": 0
    },
