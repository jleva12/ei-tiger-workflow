    },
    "place_order": {
      "x": 1680,
      "y": 200
    },
    "confirm": {
      "x": 2016,
      "y": 240
    },
    "ordered": {
      "x": 2352,
      "y": 280
    },
    "tell_requester": {
      "x": 1680,
      "y": 336
    },
    "declined": {
      "x": 2016,
