{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge agent",
  "description": "An organization's agent: a Google ADK graph workflow of nodes (ADK agents and other agents, and Forge's workflow steps: approvals, HTTP requests, transforms, delays, If / Switch / Match, loops, merges, ends) joined by edges, run from its start.",
  "type": "object",
  "required": [
    "format",
    "id",
    "name",
    "nodes",
    "edges"
  ],
  "properties": {
    "format": {
      "const": "forge.agent/v1"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "layout": {
      "type": "object",
      "description": "Where the builder draws each node, by ID. Runners ignore it.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$",
      "description": "Made by the builder, unique in the agent and never reused."
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "config",
        "outputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "kind": {
          "enum": [
            "start",
            "llm",
            "sequential",
            "parallel",
            "loop_agent",
            "saved",
            "approval",
            "human_input",
            "http",
            "transform",
            "delay",
            "if",
            "switch",
            "match",
            "loop",
            "merge",
            "end"
          ]
        },
        "name": {
          "type": "string",
          "description": "Its ADK name is this as a Python identifier (Billing specialist: billing_specialist)."
        },
        "config": {
          "type": "object"
        },
        "outputs": {
          "type": "array",
          "description": "The IDs of the ways out of the node, in order: next, or a branching step's (success / error, true / false, a case's or rule's ID and default / otherwise, each / done).",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "start"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_start"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "llm"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_llm"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sequential"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_sequential"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "parallel"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_parallel"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "loop_agent"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_loop_agent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "saved"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_saved"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "approval"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_approval"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "human_input"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_human_input"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "http"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_http"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "transform"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_transform"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "delay"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_delay"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "if"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_if"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "switch"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_switch"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "match"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_match"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "loop"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_loop"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "merge"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_merge"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "end"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_end"
              }
            }
          }
        }
      ]
    },
    "sub_agent": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "config"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "description": "Made by the builder, unique in the agent: an LLM sub-agent's answer is kept in the session's state under it."
        },
        "kind": {
          "enum": [
            "llm",
            "sequential",
            "parallel",
            "loop_agent"
          ]
        },
        "name": {
          "type": "string"
        },
        "config": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "llm"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/sub_config_llm"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sequential"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/sub_config_sequential"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "parallel"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/sub_config_parallel"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "loop_agent"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/sub_config_loop_agent"
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "source_output",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/nodeId"
        },
        "source_output": {
          "type": "string",
          "description": "One of the source node's outputs."
        },
        "target": {
          "$ref": "#/$defs/nodeId"
        }
      }
    },
    "config_start": {
      "type": "object",
      "description": "Where every run starts: what the person or system sends in.",
      "required": [
        "input_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "input_schema": {
          "type": "object",
          "description": "A JSON Schema of what a run starts with; {} takes anything."
        }
      }
    },
    "config_llm": {
      "type": "object",
      "description": "A model works on what comes in with your instruction, and can hand off to its sub-agents.",
      "required": [
        "description",
        "instruction",
        "model",
        "thinking_level",
        "output_schema",
        "include_contents",
        "disallow_transfer_to_parent",
        "disallow_transfer_to_peers",
        "max_output_tokens",
        "sub_agents",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for: what its parent and peers read when handing off to it."
        },
        "instruction": {
          "type": "string",
          "description": "What it's told to do: a template, where {{ }} puts in the run's data as it runs (input, previous, steps.<id>.output, state, a loop's item). An LLM sub-agent's answer is kept in the session's state under its ID."
        },
        "model": {
          "type": "object",
          "description": "One of the models Forge offers (its model provider configuration's): the provider's key and the model's id. Both empty: the default.",
          "required": [
            "provider",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "thinking_level": {
          "type": "string",
          "enum": [
            "",
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "description": "How long the model thinks before it answers: the level if the model offers it, else the nearest it does. Empty: the model's own."
        },
        "output_schema": {
          "type": "object",
          "description": "A JSON Schema its answer is held to; {} leaves it free text."
        },
        "include_contents": {
          "type": "string",
          "enum": [
            "default",
            "none"
          ],
          "description": "none: it sees only what it's given, not the conversation so far."
        },
        "disallow_transfer_to_parent": {
          "type": "boolean"
        },
        "disallow_transfer_to_peers": {
          "type": "boolean"
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Null: the model's limit."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "The agents it may hand off to."
        },
        "mode": {
          "type": "string",
          "enum": [
            "single_turn",
            "task"
          ],
          "description": "single_turn: it answers once. task: it may ask back until its task is done."
        }
      }
    },
    "config_sequential": {
      "type": "object",
      "description": "Runs its sub-agents one after another, each seeing what the last did.",
      "required": [
        "description",
        "sub_agents"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "Its sub-agents, in the order they run."
        }
      }
    },
    "config_parallel": {
      "type": "object",
      "description": "Runs its sub-agents at the same time, each on its own.",
      "required": [
        "description",
        "sub_agents"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "Its sub-agents, in the order they run."
        }
      }
    },
    "config_loop_agent": {
      "type": "object",
      "description": "Runs its sub-agents in order, again and again, up to a number of passes.",
      "required": [
        "description",
        "sub_agents",
        "max_iterations"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "Its sub-agents, in the order they run."
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "It stops after this many passes."
        }
      }
    },
    "config_saved": {
      "type": "object",
      "description": "Runs another of the organization's ADK workflows here, whole.",
      "required": [
        "agent"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "description": "Another of the organization's agents, by ID: run here whole."
        }
      }
    },
    "config_approval": {
      "type": "object",
      "description": "The run waits for a person to approve or reject.",
      "required": [
        "message",
        "approvers",
        "timeout_hours"
      ],
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "approvers": {
          "type": "string",
          "enum": [
            "org:admin",
            "org:member"
          ]
        },
        "timeout_hours": {
          "type": "integer",
          "minimum": 0,
          "description": "0 waits until someone decides."
        }
      }
    },
    "config_human_input": {
      "type": "object",
      "description": "Pauses for a person to answer; their answer is what it hands on.",
      "required": [
        "message",
        "response_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string",
          "description": "What the person is asked; {{ }} puts in the run's data."
        },
        "response_schema": {
          "type": "object",
          "description": "A JSON Schema of their answer; {} takes anything."
        }
      }
    },
    "config_http": {
      "type": "object",
      "description": "Calls a URL and hands on the response.",
      "required": [
        "method",
        "url",
        "headers",
        "body",
        "timeout_seconds",
        "retries",
        "output_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "body": {
          "type": "string",
          "description": "A JSONata expression making the body; an object or list is sent as JSON."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "output_schema": {
          "type": "object",
          "description": "A JSON Schema of the response's body; {} leaves it undeclared."
        }
      }
    },
    "config_transform": {
      "type": "object",
      "description": "Reshapes data with a JSONata expression.",
      "required": [
        "expression",
        "output_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "expression": {
          "type": "string",
          "description": "A JSONata expression: what the step hands on."
        },
        "output_schema": {
          "type": "object",
          "description": "A JSON Schema of what it makes; {} leaves it undeclared."
        }
      }
    },
    "config_delay": {
      "type": "object",
      "description": "Waits a while before going on.",
      "required": [
        "amount",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "days"
          ]
        }
      }
    },
    "config_if": {
      "type": "object",
      "description": "Takes one of two ways, on a condition.",
      "required": [
        "condition"
      ],
      "additionalProperties": false,
      "properties": {
        "condition": {
          "type": "string",
          "description": "A JSONata expression; true takes the True way."
        }
      }
    },
    "config_switch": {
      "type": "object",
      "description": "Routes on one value: to the case it equals.",
      "required": [
        "value",
        "cases"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "description": "A JSONata expression; the case it equals (as text) is taken."
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "config_match": {
      "type": "object",
      "description": "Routes to the first rule whose condition holds.",
      "required": [
        "arms"
      ],
      "additionalProperties": false,
      "properties": {
        "arms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "condition"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              }
            }
          },
          "description": "In order: the first rule whose JSONata condition is true is taken."
        }
      }
    },
    "config_loop": {
      "type": "object",
      "description": "Runs its body once for each item in a list.",
      "required": [
        "items",
        "item_name",
        "max_iterations",
        "concurrency"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "string",
          "description": "A JSONata expression giving a list."
        },
        "item_name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "config_merge": {
      "type": "object",
      "description": "Waits for the ways coming into it, then goes on as one.",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ]
        }
      }
    },
    "config_end": {
      "type": "object",
      "description": "Finishes the run, as succeeded or failed, with a result.",
      "required": [
        "outcome",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "result": {
          "type": "string",
          "description": "A JSONata expression giving the workflow's result."
        }
      }
    },
    "sub_config_llm": {
      "type": "object",
      "description": "A sub-agent: A model works on what comes in with your instruction, and can hand off to its sub-agents.",
      "required": [
        "description",
        "instruction",
        "model",
        "thinking_level",
        "output_schema",
        "include_contents",
        "disallow_transfer_to_parent",
        "disallow_transfer_to_peers",
        "max_output_tokens",
        "sub_agents"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for: what its parent and peers read when handing off to it."
        },
        "instruction": {
          "type": "string",
          "description": "What it's told to do: a template, where {{ }} puts in the run's data as it runs (input, previous, steps.<id>.output, state, a loop's item). An LLM sub-agent's answer is kept in the session's state under its ID."
        },
        "model": {
          "type": "object",
          "description": "One of the models Forge offers (its model provider configuration's): the provider's key and the model's id. Both empty: the default.",
          "required": [
            "provider",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "thinking_level": {
          "type": "string",
          "enum": [
            "",
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "description": "How long the model thinks before it answers: the level if the model offers it, else the nearest it does. Empty: the model's own."
        },
        "output_schema": {
          "type": "object",
          "description": "A JSON Schema its answer is held to; {} leaves it free text."
        },
        "include_contents": {
          "type": "string",
          "enum": [
            "default",
            "none"
          ],
          "description": "none: it sees only what it's given, not the conversation so far."
        },
        "disallow_transfer_to_parent": {
          "type": "boolean"
        },
        "disallow_transfer_to_peers": {
          "type": "boolean"
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Null: the model's limit."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "The agents it may hand off to."
        }
      }
    },
    "sub_config_sequential": {
      "type": "object",
      "description": "A sub-agent: Runs its sub-agents one after another, each seeing what the last did.",
      "required": [
        "description",
        "sub_agents"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "Its sub-agents, in the order they run."
        }
      }
    },
    "sub_config_parallel": {
      "type": "object",
      "description": "A sub-agent: Runs its sub-agents at the same time, each on its own.",
      "required": [
        "description",
        "sub_agents"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "Its sub-agents, in the order they run."
        }
      }
    },
    "sub_config_loop_agent": {
      "type": "object",
      "description": "A sub-agent: Runs its sub-agents in order, again and again, up to a number of passes.",
      "required": [
        "description",
        "sub_agents",
        "max_iterations"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "Its sub-agents, in the order they run."
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "It stops after this many passes."
        }
      }
    }
  }
