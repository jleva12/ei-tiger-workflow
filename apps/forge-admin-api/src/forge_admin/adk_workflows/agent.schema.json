{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forge agent",
  "description": "An organization's agent: a Google ADK graph workflow of nodes (ADK agents and other agents, and Forge's workflow steps: approvals, HTTP requests, transforms, delays, If / Switch / Match, loops, merges, ends) joined by edges, run from its start.",
  "type": "object",
  "required": [
    "format",
    "id",
    "name",
    "nodes",
    "edges"
  ],
  "properties": {
    "format": {
      "const": "forge.agent/v1"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Which published version this is; a draft has none (an export of one carries it)."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "layout": {
      "type": "object",
      "description": "Where the builder draws each node, by ID. Runners ignore it.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$",
      "description": "Made by the builder, unique in the agent and never reused."
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "config",
        "outputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "kind": {
          "enum": [
            "start",
            "llm",
            "sequential",
            "parallel",
            "loop_agent",
            "saved",
            "approval",
            "human_input",
            "http",
            "transform",
            "delay",
            "if",
            "switch",
            "match",
            "loop",
            "merge",
            "end"
          ]
        },
        "name": {
          "type": "string",
          "description": "Its ADK name is this as a Python identifier (Billing specialist: billing_specialist)."
        },
        "config": {
          "type": "object"
        },
        "outputs": {
          "type": "array",
          "description": "The IDs of the ways out of the node, in order: next, or a branching step's (success / error, true / false, a case's or rule's ID and default / otherwise, each / done).",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "start"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_start"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "llm"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_llm"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sequential"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_sequential"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "parallel"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_parallel"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "loop_agent"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_loop_agent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "saved"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_saved"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "approval"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_approval"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "human_input"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_human_input"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "http"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_http"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "transform"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_transform"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "delay"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_delay"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "if"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_if"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "switch"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_switch"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "match"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_match"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "loop"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_loop"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "merge"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_merge"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "end"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config_end"
              }
            }
          }
        }
      ]
    },
    "sub_agent": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "config"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "description": "Made by the builder, unique in the agent: an LLM sub-agent's answer is kept in the session's state under it."
        },
        "kind": {
          "enum": [
            "llm",
            "sequential",
            "parallel",
            "loop_agent"
          ]
        },
        "name": {
          "type": "string"
        },
        "config": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "llm"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/sub_config_llm"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sequential"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/sub_config_sequential"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "parallel"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/sub_config_parallel"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "loop_agent"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/sub_config_loop_agent"
              }
            }
          }
        }
      ]
    },
    "tool": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "config"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "description": "Made by the builder, unique among its agent's tools."
        },
        "kind": {
          "enum": [
            "mcp",
            "knowledge_base",
            "http_tool",
            "openapi",
            "saved_agent",
            "adk_workflow"
          ]
        },
        "name": {
          "type": "string",
          "description": "What it's called: an HTTP tool's or knowledge base's name for the model, as a Python identifier."
        },
        "config": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "mcp"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/tool_config_mcp"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "knowledge_base"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/tool_config_knowledge_base"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "http_tool"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/tool_config_http_tool"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "openapi"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/tool_config_openapi"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "saved_agent"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/tool_config_saved_agent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "adk_workflow"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/tool_config_adk_workflow"
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "source_output",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/nodeId"
        },
        "source_output": {
          "type": "string",
          "description": "One of the source node's outputs."
        },
        "target": {
          "$ref": "#/$defs/nodeId"
        }
      }
    },
    "config_start": {
      "type": "object",
      "description": "Where every run starts: what the person or system sends in.",
      "required": [
        "input_schema",
        "allow_files",
        "file_types"
      ],
      "additionalProperties": false,
      "properties": {
        "input_schema": {
          "type": "object",
          "description": "A JSON Schema of what a run starts with; {} takes anything."
        },
        "allow_files": {
          "type": "boolean",
          "description": "Whether a run may start with files: each is saved as an ADK artifact of the run's session, its steps read it there (ctx.load_artifact, an LLM agent's load_artifacts tool), and state.files lists them."
        },
        "file_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pdf",
              "word",
              "powerpoint",
              "text",
              "markdown",
              "html",
              "excel",
              "csv",
              "json",
              "xml",
              "png",
              "jpeg",
              "gif",
              "webp",
              "mp3",
              "wav",
              "mp4",
              "zip"
            ]
          },
          "uniqueItems": true,
          "description": "The types of files it takes, by their extension; none takes any type."
        }
      }
    },
    "config_llm": {
      "type": "object",
      "description": "A model works on what comes in with your instruction, and can hand off to its sub-agents.",
      "required": [
        "description",
        "instruction",
        "model",
        "thinking_level",
        "output_schema",
        "include_contents",
        "disallow_transfer_to_parent",
        "disallow_transfer_to_peers",
        "max_output_tokens",
        "sub_agents",
        "tools",
        "mode",
        "source",
        "agent",
        "version",
        "message",
        "inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for: what its parent and peers read when handing off to it."
        },
        "instruction": {
          "type": "string",
          "description": "What it's told to do: a template, where {{ }} puts in the run's data as it runs (input, previous, steps.<id>.output, state, a loop's item). An LLM sub-agent's answer is kept in the session's state under its ID."
        },
        "model": {
          "type": "object",
          "description": "One of the models Forge offers (its model provider configuration's): the provider's key and the model's id. Both empty: the default.",
          "required": [
            "provider",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "thinking_level": {
          "type": "string",
          "enum": [
            "",
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "description": "How long the model thinks before it answers: the level if the model offers it, else the nearest it does. Empty: the model's own."
        },
        "output_schema": {
          "type": "object",
          "description": "A JSON Schema its answer is held to; {} leaves it free text."
        },
        "include_contents": {
          "type": "string",
          "enum": [
            "default",
            "none"
          ],
          "description": "none: it sees only what it's given, not the conversation so far."
        },
        "disallow_transfer_to_parent": {
          "type": "boolean"
        },
        "disallow_transfer_to_peers": {
          "type": "boolean"
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Null: the model's limit."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "The agents it may hand off to."
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          },
          "description": "What it can call: the Agents builder's tools (an MCP server, a knowledge base, an HTTP endpoint, an OpenAPI spec, an agent, a workflow), each with that builder's settings."
        },
        "mode": {
          "type": "string",
          "enum": [
            "single_turn",
            "task"
          ],
          "description": "single_turn: it answers once. task: it may ask back until its task is done."
        },
        "source": {
          "type": "string",
          "enum": [
            "inline",
            "agent"
          ],
          "description": "inline: set up here, with these settings. agent: an agent from the Agents page, used whole (its own instruction, model and tools); the settings above other than output_schema don't apply."
        },
        "agent": {
          "type": "string",
          "description": "The agent from the Agents page (ca_…), when source is agent."
        },
        "version": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "const": "draft"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which of its versions runs: a published one, its draft, or null for its latest published (as each run starts)."
        },
        "message": {
          "type": "string",
          "description": "What it's sent: a template, where {{ }} puts in the run's data; empty sends what the node is handed."
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "The fields of its input schema (state_schema), each a JSONata expression over the run's data."
        }
      }
    },
    "config_sequential": {
      "type": "object",
      "description": "Runs its sub-agents one after another, each seeing what the last did.",
      "required": [
        "description",
        "sub_agents"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "Its sub-agents, in the order they run."
        }
      }
    },
    "config_parallel": {
      "type": "object",
      "description": "Runs its sub-agents at the same time, each on its own.",
      "required": [
        "description",
        "sub_agents"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "Its sub-agents, in the order they run."
        }
      }
    },
    "config_loop_agent": {
      "type": "object",
      "description": "Runs its sub-agents in order, again and again, up to a number of passes.",
      "required": [
        "description",
        "sub_agents",
        "max_iterations"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "Its sub-agents, in the order they run."
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "It stops after this many passes."
        }
      }
    },
    "config_saved": {
      "type": "object",
      "description": "Runs another of the organization's workflows here, whole.",
      "required": [
        "agent",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "description": "Another of the organization's agents, by ID: run here whole."
        },
        "version": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "const": "draft"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which of its versions runs: a published one, its draft, or null for its latest published (as each run starts)."
        }
      }
    },
    "config_approval": {
      "type": "object",
      "description": "The run waits for a person to approve or reject.",
      "required": [
        "message",
        "approvers",
        "timeout_hours"
      ],
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "approvers": {
          "type": "string",
          "enum": [
            "org:admin",
            "org:member"
          ]
        },
        "timeout_hours": {
          "type": "integer",
          "minimum": 0,
          "description": "0 waits until someone decides."
        }
      }
    },
    "config_human_input": {
      "type": "object",
      "description": "Pauses for a person to answer; their answer is what it hands on.",
      "required": [
        "message",
        "response_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string",
          "description": "What the person is asked; {{ }} puts in the run's data."
        },
        "response_schema": {
          "type": "object",
          "description": "A JSON Schema of their answer; {} takes anything."
        }
      }
    },
    "config_http": {
      "type": "object",
      "description": "Calls a URL and hands on the response.",
      "required": [
        "method",
        "url",
        "headers",
        "body",
        "timeout_seconds",
        "retries",
        "output_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "body": {
          "type": "string",
          "description": "A JSONata expression making the body; an object or list is sent as JSON."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "output_schema": {
          "type": "object",
          "description": "A JSON Schema of the response's body; {} leaves it undeclared."
        }
      }
    },
    "config_transform": {
      "type": "object",
      "description": "Reshapes data with a JSONata expression.",
      "required": [
        "expression",
        "output_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "expression": {
          "type": "string",
          "description": "A JSONata expression: what the step hands on."
        },
        "output_schema": {
          "type": "object",
          "description": "A JSON Schema of what it makes; {} leaves it undeclared."
        }
      }
    },
    "config_delay": {
      "type": "object",
      "description": "Waits a while before going on.",
      "required": [
        "amount",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "days"
          ]
        }
      }
    },
    "config_if": {
      "type": "object",
      "description": "Takes one of two ways, on a condition.",
      "required": [
        "condition"
      ],
      "additionalProperties": false,
      "properties": {
        "condition": {
          "type": "string",
          "description": "A JSONata expression; true takes the True way."
        }
      }
    },
    "config_switch": {
      "type": "object",
      "description": "Routes on one value: to the case it equals.",
      "required": [
        "value",
        "cases"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "description": "A JSONata expression; the case it equals (as text) is taken."
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "config_match": {
      "type": "object",
      "description": "Routes to the first rule whose condition holds, or to every one.",
      "required": [
        "arms",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "arms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "condition"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              }
            }
          },
          "description": "In order: the first rule whose JSONata condition is true is taken (mode first), or every one, at once (mode all)."
        },
        "mode": {
          "type": "string",
          "enum": [
            "first",
            "all"
          ],
          "description": "first takes the first rule that holds; all takes every one that holds, at once."
        }
      }
    },
    "config_loop": {
      "type": "object",
      "description": "Runs its body once for each item in a list.",
      "required": [
        "items",
        "item_name",
        "max_iterations",
        "concurrency"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "string",
          "description": "A JSONata expression giving a list."
        },
        "item_name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "config_merge": {
      "type": "object",
      "description": "Waits for the ways coming into it, then goes on as one.",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ]
        }
      }
    },
    "config_end": {
      "type": "object",
      "description": "Finishes the run, as succeeded or failed, with a result.",
      "required": [
        "outcome",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "result": {
          "type": "string",
          "description": "A JSONata expression giving the workflow's result."
        }
      }
    },
    "tool_config_mcp": {
      "type": "object",
      "description": "A tool: The tools of one of the organization's MCP servers, or one by URL.",
      "required": [
        "server",
        "transport",
        "url",
        "headers",
        "tools",
        "confirm"
      ],
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "string",
          "description": "One of the organization's MCP servers, by ID: its URL, headers and sign-in come from there. Empty for one set up by transport, url and headers."
        },
        "transport": {
          "type": "string",
          "enum": [
            "streamable_http",
            "sse"
          ]
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "tools": {
          "type": "string",
          "description": "The server's tools it may call, comma-separated; empty for all."
        },
        "confirm": {
          "type": "boolean"
        }
      }
    },
    "tool_config_knowledge_base": {
      "type": "object",
      "description": "A tool: Searches the organization's knowledge bases for passages.",
      "required": [
        "knowledge_bases",
        "description",
        "max_results"
      ],
      "additionalProperties": false,
      "properties": {
        "knowledge_bases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The organization's knowledge bases it searches, by ID: their documents, parsed, chunked and embedded."
        },
        "description": {
          "type": "string",
          "description": "What the model is told it finds there; empty to describe the knowledge bases."
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "The most passages one search answers."
        }
      }
    },
    "tool_config_http_tool": {
      "type": "object",
      "description": "A tool: Calls an HTTP endpoint with arguments the model fills in.",
      "required": [
        "description",
        "method",
        "url",
        "headers",
        "parameters",
        "confirm"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it does: the model decides when to call it by this."
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "url": {
          "type": "string",
          "description": "Where it calls; {name} puts in an argument of that name."
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "parameters": {
          "type": "object",
          "description": "A JSON Schema of the arguments the model fills in; {} takes none."
        },
        "confirm": {
          "type": "boolean",
          "description": "A person confirms each call before it's made."
        }
      }
    },
    "tool_config_openapi": {
      "type": "object",
      "description": "A tool: The operations of an OpenAPI spec, each a tool.",
      "required": [
        "source",
        "url",
        "spec",
        "operations",
        "confirm"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "url",
            "inline"
          ]
        },
        "url": {
          "type": "string",
          "description": "Where the spec is, when its source is url."
        },
        "spec": {
          "type": "string",
          "description": "An OpenAPI 3 spec, JSON or YAML, when its source is inline."
        },
        "operations": {
          "type": "string",
          "description": "The operation IDs it may call, comma-separated; empty for all."
        },
        "confirm": {
          "type": "boolean"
        }
      }
    },
    "tool_config_saved_agent": {
      "type": "object",
      "description": "A tool: An agent from the Agents page, called as a tool.",
      "required": [
        "agent"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "description": "Another of the organization's agents, by ID."
        }
      }
    },
    "tool_config_adk_workflow": {
      "type": "object",
      "description": "A tool: Runs another of the organization's workflows and reads its result.",
      "required": [
        "workflow",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "type": "string",
          "description": "One of the organization's workflows, by ID, called as a tool."
        },
        "version": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "const": "draft"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which of its versions runs: a published one, its draft, or null for its latest published (as each run starts)."
        }
      }
    },
    "sub_config_llm": {
      "type": "object",
      "description": "A sub-agent: A model works on what comes in with your instruction, and can hand off to its sub-agents.",
      "required": [
        "description",
        "instruction",
        "model",
        "thinking_level",
        "output_schema",
        "include_contents",
        "disallow_transfer_to_parent",
        "disallow_transfer_to_peers",
        "max_output_tokens",
        "sub_agents",
        "tools"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for: what its parent and peers read when handing off to it."
        },
        "instruction": {
          "type": "string",
          "description": "What it's told to do: a template, where {{ }} puts in the run's data as it runs (input, previous, steps.<id>.output, state, a loop's item). An LLM sub-agent's answer is kept in the session's state under its ID."
        },
        "model": {
          "type": "object",
          "description": "One of the models Forge offers (its model provider configuration's): the provider's key and the model's id. Both empty: the default.",
          "required": [
            "provider",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "thinking_level": {
          "type": "string",
          "enum": [
            "",
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "description": "How long the model thinks before it answers: the level if the model offers it, else the nearest it does. Empty: the model's own."
        },
        "output_schema": {
          "type": "object",
          "description": "A JSON Schema its answer is held to; {} leaves it free text."
        },
        "include_contents": {
          "type": "string",
          "enum": [
            "default",
            "none"
          ],
          "description": "none: it sees only what it's given, not the conversation so far."
        },
        "disallow_transfer_to_parent": {
          "type": "boolean"
        },
        "disallow_transfer_to_peers": {
          "type": "boolean"
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Null: the model's limit."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "The agents it may hand off to."
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          },
          "description": "What it can call: the Agents builder's tools (an MCP server, a knowledge base, an HTTP endpoint, an OpenAPI spec, an agent, a workflow), each with that builder's settings."
        }
      }
    },
    "sub_config_sequential": {
      "type": "object",
      "description": "A sub-agent: Runs its sub-agents one after another, each seeing what the last did.",
      "required": [
        "description",
        "sub_agents"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "Its sub-agents, in the order they run."
        }
      }
    },
    "sub_config_parallel": {
      "type": "object",
      "description": "A sub-agent: Runs its sub-agents at the same time, each on its own.",
      "required": [
        "description",
        "sub_agents"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "Its sub-agents, in the order they run."
        }
      }
    },
    "sub_config_loop_agent": {
      "type": "object",
      "description": "A sub-agent: Runs its sub-agents in order, again and again, up to a number of passes.",
      "required": [
        "description",
        "sub_agents",
        "max_iterations"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "What it's for."
        },
        "sub_agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sub_agent"
          },
          "description": "Its sub-agents, in the order they run."
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "It stops after this many passes."
        }
      }
    }
  }
}
