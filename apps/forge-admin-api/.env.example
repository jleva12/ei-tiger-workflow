# forge-admin configuration. make env copies this to .env; keep real
# credentials out of this template. Precedence, lowest to highest: built-in
# defaults, .env in the working directory, the process environment.
# Values the admin shares with other apps (MySQL, MongoDB, Redis, model keys)
# come from the repository's .env.common, which make env creates, by ${NAME}
# reference: an earlier line of this file wins, and only the names referenced
# here are read (forge_admin.env_files). Compose resolves the references,
# passes .env to the container and overrides the listener and the MySQL
# connection to reach its admin-mysql service.

# API: routers mount below the prefix; docs at /docs and /openapi.json.
FORGE_ADMIN_API_PREFIX=/api/v1
FORGE_ADMIN_DOCS_ENABLED=true
# Browser origins allowed to call the API, as a JSON array: the web dev
# server (make web) and the Compose web console (make up).
FORGE_ADMIN_CORS_ORIGINS=["http://localhost:5190","http://localhost:18190"]
# Set to require this value in the X-API-Key header on API routes; health
# probes stay open. Leave empty to disable.
FORGE_ADMIN_API_KEY=
# Bearer tokens: requests identify the user with "Authorization: Bearer <JWT>"
# whose sub is their user ID, signed HS256 with this secret (at least 32
# characters). make env generates one into .env; make web-token mints a token
# with it for the web console. Leave empty to refuse bearer tokens.
FORGE_ADMIN_JWT_SECRET=
# Tokens must carry this issuer (iss) and audience (aud); minted ones do.
FORGE_ADMIN_JWT_ISSUER=forge-local
FORGE_ADMIN_JWT_AUDIENCE=forge-admin
# LOCAL DEVELOPMENT ONLY: treat requests without a bearer token as this user.
# Leave it empty, so requests sign in with a token as in production; the
# tests set it. Never set it in production.
FORGE_ADMIN_LOCAL_USER_ID=

# The site administrator make infrastructure (forge-admin-seed) adds to users
# and gives site:admin: locally, you. They can then add everyone else, and
# make web-token signs the web console in as them. Fill in your details; the
# ID can stay. Emails and MS IDs are stored in lowercase.
FORGE_ADMIN_SITE_ADMIN_ID=d2a66448-9446-46be-81ca-a8c73197df05
FORGE_ADMIN_SITE_ADMIN_FIRST_NAME=
FORGE_ADMIN_SITE_ADMIN_LAST_NAME=
FORGE_ADMIN_SITE_ADMIN_EMAIL=
FORGE_ADMIN_SITE_ADMIN_MSID=

# The web console's address, for links to its pages. make up's web console
# is on 18190.
FORGE_ADMIN_WEB_URL=http://localhost:5190

# The Redis the async worker's SAQ queues run on, where the jobs that take
# ADK workflow runs are queued (the runs themselves are kept in MySQL, below).
# make async-worker-deps publishes it on 127.0.0.1:16389; Compose points the
# admin at the shared redis. Unset, starting or carrying on a run answers
# that it isn't set up.
FORGE_ADMIN_EMBEDDING_REDIS_URL=${FORGE_REDIS_URL}

# The assistant: a Google ADK agent, served at /api/v1/agents. The models it
# may run on come from the model-provider YAML ADK workflows' LLM nodes read
# too (packages/python/common/src/forge_common/model_provider), when this
# names it; its ${NAME} references resolve from the process environment,
# then from this file, so reference the keys its providers need below, e.g.
# OPENAI_API_KEY=${OPENAI_API_KEY}. The web console's model picker lists its
# models (GET /api/v1/agents/apps/forge/models).
# model_provider.openai.yaml offers OpenAI's and Anthropic's (Claude) models:
# FORGE_ADMIN_MODEL_PROVIDER_CONFIG=../../packages/python/common/src/forge_common/model_provider/model_provider.openai.yaml
# OPENAI_API_KEY=${OPENAI_API_KEY}
# ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
# OPENAI_MODEL=gpt-5.2
# Without it, the assistant runs on Gemini: its API key, from
# https://aistudio.google.com/apikey (GOOGLE_API_KEY works too), shared with
# ADK workflows' LLM nodes through .env.common; without one it answers that it
# isn't set up.
FORGE_ADMIN_GOOGLE_API_KEY=${FORGE_GOOGLE_API_KEY}
# The model it runs on until a conversation chooses: with the YAML one of its
# models (provider/model, or an id), by default its default; without, a
# Gemini model, by default gemini-3.5-flash. And the models a conversation
# may choose (a JSON array): with the YAML, which of its models (all when
# empty); without, other Gemini models.
FORGE_ADMIN_AGENT_MODEL=
FORGE_ADMIN_AGENT_MODELS=[]
# What the assistant has on each screen (toolsets, instructions, default
# model, suggested prompts): a YAML file shaped like
# src/forge_admin/assistant/screens.yaml, which is used when this is empty.
FORGE_ADMIN_AGENT_SCREENS=

# HTTP listener for native runs (make admin). Compose serves on ADMIN_PORT.
FORGE_ADMIN_HOST=127.0.0.1
FORGE_ADMIN_PORT=8101
FORGE_ADMIN_RELOAD=false

# Logging (forge_common.logging): every logger, the API's, uvicorn's and the
# libraries', as one structured format, and one access line per request; each
# request's lines carry its request_id, which the response's X-Request-ID
# header returns. DEBUG, INFO, WARNING, ERROR or CRITICAL.
FORGE_ADMIN_LOGGING__LEVEL=INFO
# json (one object per line, for log collectors) or console (key=value).
# Unset, console on a terminal and json otherwise (containers, pipes).
FORGE_ADMIN_LOGGING__FORMAT=console
# Colors in the console format. Unset, on for a terminal or FORCE_COLOR
# and off for NO_COLOR; true colors piped output too (the Claude app's
# or an IDE's run panel, make up-all-local).
FORGE_ADMIN_LOGGING__COLORS=true
FORGE_ADMIN_LOGGING__ACCESS_LOG=true
# FORGE_ADMIN_LOGGING__ACCESS_LOG_EXCLUDE_PATHS=["/health/live","/health/ready"]
# Replaces the default per-logger levels (httpx, httpx2, httpcore and
# watchfiles at WARNING):
# FORGE_ADMIN_LOGGING__LEVELS={"httpx":"WARNING","google_adk":"DEBUG"}

# MySQL, shared through .env.common: the organizations, people and access,
# the ADK workflow runs and their ADK sessions, and the assistant's
# conversations. Its defaults match admin-mysql in
# apps/forge-admin-api/compose.yaml, which make admin-deps publishes on
# 127.0.0.1:13326 (ADMIN_MYSQL_PORT).
FORGE_ADMIN_MYSQL_HOST=${FORGE_MYSQL_HOST}
FORGE_ADMIN_MYSQL_PORT=${FORGE_MYSQL_PORT}
FORGE_ADMIN_MYSQL_DATABASE=${FORGE_MYSQL_DATABASE}
FORGE_ADMIN_MYSQL_USER=${FORGE_MYSQL_USER}
FORGE_ADMIN_MYSQL_PASSWORD=${FORGE_MYSQL_PASSWORD}
FORGE_ADMIN_MYSQL_POOL_SIZE=5
FORGE_ADMIN_MYSQL_MAX_OVERFLOW=10
FORGE_ADMIN_MYSQL_POOL_RECYCLE=1800
FORGE_ADMIN_MYSQL_CONNECT_TIMEOUT=10

# MongoDB, where organizations' ADK workflows are kept as the JSON documents
# the web builder saves (one per ADK workflow, scoped to its organization).
# make admin-deps starts the shared MongoDB. Compose points the admin at
# mongo; native connections use .env.common.
FORGE_ADMIN_MONGO_URI=${FORGE_MONGO_URI}
FORGE_ADMIN_MONGO_DATABASE=forge_admin

# Apply pending Alembic migrations before serving. With several replicas,
# set false and run the migrations once per release instead.
FORGE_ADMIN_MIGRATE_ON_START=true
# Seconds MySQL has to answer /health/ready before the probe reports 503.
FORGE_ADMIN_READY_TIMEOUT=2
