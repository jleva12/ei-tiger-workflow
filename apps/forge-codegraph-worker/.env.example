# codegraph-worker configuration. Precedence, lowest to highest: built-in
# defaults, codegraph.yaml (in the working directory or /etc/codegraph, or the
# file named by CODEGRAPH_CONFIG_FILE), this file, the process environment.
# CODEGRAPH_ENV_FILE selects another dotenv file; set it empty to disable file
# loading. Values use dotenv syntax; durations like 2h, 10m, 30s. Every setting
# also has a YAML path: CODEGRAPH_SPANNER_DATABASE is spanner.database,
# CODEGRAPH_PARSER_MAX_SYNTAX_NODES is parser.max_syntax_nodes. make env copies
# this to .env. Keep real tokens out of this template. Values the worker
# shares with other apps (the admission token, the GitHub token, the cursor
# key, the embedding model and dimensions, the OpenAI key) come from
# the repository's .env.common, which make env creates, by ${NAME}
# reference: an earlier line of this file wins, and only the names referenced
# here are loaded (FORGE_ENV_COMMON_FILE names another file; empty disables
# it).

# Spanner is the only durable backend: repositories, runs, jobs, the versioned
# graph, per-file identity maps, retained source and embeddings.
CODEGRAPH_SPANNER_DATABASE=projects/codegraph-local/instances/codegraph/databases/codegraph
# Namespace for this deployment's data inside the database.
CODEGRAPH_SCOPE=codegraph
# Signs pagination cursors; at least 32 bytes; keep stable across restarts.
# Readers of the same graph must share it, so it is the shared one in
# .env.common, which make env generates.
CODEGRAPH_GRAPH_CURSOR_SIGNING_KEY=${FORGE_CODEGRAPH_CURSOR_SIGNING_KEY}
# Create the emulator instance/database and apply the schema at startup.
# Requires SPANNER_EMULATOR_HOST; never used against managed Spanner.
CODEGRAPH_SPANNER_AUTO_PROVISION=false

# The queue of ingestion jobs: the Forge admin API's MySQL, whose
# code_ingestion_jobs table its migrations create (make admin-migrate). The
# admin API queues an ingestion there for an organization's repository; the
# worker claims it, admits its run in Spanner, builds the graph and writes
# the outcome back. A go-sql-driver DSN from the shared MySQL settings in
# .env.common (keep its user and password URL-safe); Compose points it at
# admin-mysql.
CODEGRAPH_JOBS_MYSQL_DSN=${FORGE_MYSQL_USER}:${FORGE_MYSQL_PASSWORD}@tcp(${FORGE_MYSQL_HOST}:${FORGE_MYSQL_PORT})/${FORGE_MYSQL_DATABASE}
# The queue the worker claims from (code_ingestion_jobs.queue); the admin
# API queues on "ingestion". Failed attempts before a job fails for good are
# CODEGRAPH_MAX_ATTEMPTS, below.
CODEGRAPH_QUEUE=ingestion
# Repositories ingested concurrently by this process; one run per repository at a time.
CODEGRAPH_TASK_CONCURRENCY=1
CODEGRAPH_SHUTDOWN_TIMEOUT=30s
CODEGRAPH_STARTUP_TIMEOUT=15s
CODEGRAPH_CLEANUP_TIMEOUT=15s
# /livez and /readyz; empty disables the listener.
CODEGRAPH_HEALTH_ADDR=127.0.0.1:8090
CODEGRAPH_LOG_LEVEL=info
# Log format: json or text.
CODEGRAPH_LOG_FORMAT=json

# The worker's API on the health listener: a trusted caller (e.g. the Forge
# admin API) reads published graphs, runs and the ingestion audit with this
# bearer token, shared through .env.common; see README.md. Empty leaves the
# API off. (Named for when the API also admitted ingestions.)
CODEGRAPH_ADMISSION_TOKEN=${FORGE_CODEGRAPH_ADMISSION_TOKEN}
# How the worker reads GitHub: every clone, fetch and branch read sends this
# token, from FORGE_GITHUB_TOKEN in .env.common. A fine-grained personal
# access token with read access to the repositories' contents is enough.
# Empty reads GitHub anonymously, so only public repositories can be
# ingested; a job for a private one fails (repository_unreadable).
CODEGRAPH_GITHUB_TOKEN=${FORGE_GITHUB_TOKEN}

# Worker-local state: git mirrors, the syntax cache and run indexes. All of it
# is disposable; Spanner holds everything a later run or a reader needs.
CODEGRAPH_WORK_DIR=.codegraph-work

# Build settings: auto, maven-resolved, gradle, manifest or syntax.
CODEGRAPH_BUILD_MODE=auto
CODEGRAPH_MANIFEST=.codegraph/build-context.json
# Language adapters and their settings. Compose replaces this with Java,
# TypeScript and Python on the image's JDK and Maven, so this value only
# applies to native runs (make worker). Java requires a JDK: javac is the
# binding authority, and its paths must be absolute. java_home must contain no
# symlinks (the worker fingerprints the JDK and refuses them), so point it at
# a copy made with cp -RL, as the image does; macOS JDKs have symlinks. Java
# also needs Maven and CODEGRAPH_BUILD_MODE=maven-resolved: in the other modes
# no JDK or dependencies are resolved, and every run with Java sources fails
# at the resolve stage (docs/language-routing.md). Optional build_java_homes
# maps major versions to older JDKs Maven builds old projects with (Java 8
# projects often fail on a new JDK); it may use a JDK as installed
# (docs/java-maven-inputs.md). Optional lombok_jar is a Lombok that runs on
# java_home (1.18.38 or later for JDK 24), used when a project's own Lombok is
# too old to (docs/language-routing.md). To ingest Java natively, use a line
# like this:
# CODEGRAPH_LANGUAGES='{"java":{"fallback_release":21,"java_home":"/abs/jdk","build_java_homes":{"8":"/abs/jdk8"},"lombok_jar":"/abs/lombok.jar","maven_executable":"/abs/mvn","cache_dir":"/abs/codegraph/java/cache","work_dir":"/abs/codegraph/java/work","max_heap_mib":2048},"typescript":{},"python":{}}'
CODEGRAPH_LANGUAGES='{"typescript":{},"python":{}}'
# Python uses the bundled Pyright analyzer; see docs/python-ingestion.md (in
# apps/forge-codegraph-worker) for explicit import roots and fingerprinted dependency
# directories. With uv on PATH, the packages each checkout declares are
# installed from wheels for the analysis (never built or run), cached under
# CODEGRAPH_WORK_DIR/python-packages; "python":{"install":{"enabled":false}}
# turns that off, and install.index_url points it at a private index.
# TypeScript is bound by the TypeScript compiler (typescript-analyzer, built
# by make worker-install) with each npm project's packages installed by npm
# with every script off, cached under CODEGRAPH_WORK_DIR/typescript-packages;
# "typescript":{"compiler":{"enabled":false}} binds by syntax alone and
# "typescript":{"install":{"registry":"https://..."}} sets the registry
# (docs/typescript-compiler.md).
# Manifest root names mapped to absolute directories; {} when none are mounted.
CODEGRAPH_ROOTS='{}'

# Per-run deadline and git timeout.
CODEGRAPH_TIMEOUT=2h
CODEGRAPH_CLONE_TIMEOUT=10m

# Repository lease held by a running ingestion. Renewal retries until the TTL
# actually expires; the renew interval must be under half the TTL.
CODEGRAPH_LEASE_TTL=2m
CODEGRAPH_LEASE_RENEW_INTERVAL=30s
# Failed attempts before a job is marked DEAD.
CODEGRAPH_MAX_ATTEMPTS=6

# Parser workers (1-64) and the memory budget that bounds them.
CODEGRAPH_WORKERS=8
CODEGRAPH_WORKER_BUDGET_BYTES=2147483648
# Persistent syntax cache size (gzipped IR keyed by content hash); 2 GiB.
CODEGRAPH_SYNTAX_CACHE_BYTES=2147483648

# Graph loader: records per Spanner commit and concurrent commits.
CODEGRAPH_LOADER_BATCH_RECORDS=1000
CODEGRAPH_LOADER_CONCURRENCY=8

# Discovery and parser limits, per file unless noted.
CODEGRAPH_MAX_FILES=100000
CODEGRAPH_MAX_HASH_BYTES=8589934592
CODEGRAPH_DISCOVERY_MAX_ENTRIES=1000000
CODEGRAPH_DISCOVERY_MAX_DEPTH=128
CODEGRAPH_DISCOVERY_MAX_ROOTS=1024
CODEGRAPH_DISCOVERY_MAX_ISSUES=128
# Paths with a segment starting with a dot (.github, .agents, .eslintrc.js)
# and tests (test source sets, test/tests/__tests__/__mocks__ directories,
# test_*.py, *_test.py, conftest.py, tests.py, *.test.* and *.spec.*) are
# left out of the graph; true analyses them too.
CODEGRAPH_DISCOVERY_INCLUDE_HIDDEN=false
CODEGRAPH_DISCOVERY_INCLUDE_TESTS=false
CODEGRAPH_BUILD_MAX_INPUT_BYTES=4194304
CODEGRAPH_BUILD_MAX_RECORDS=1000000
CODEGRAPH_BUILD_MAX_DIAGNOSTICS=20000
CODEGRAPH_BUILD_MAX_FILES=2000000
CODEGRAPH_BUILD_MAX_HASH_BYTES=8589934592
CODEGRAPH_BUILD_MAX_DEPTH=128
CODEGRAPH_BUILD_MAX_OUTPUT_BYTES=134217728
CODEGRAPH_MAX_SOURCE_BYTES=4194304
CODEGRAPH_PARSER_MAX_SYNTAX_NODES=250000
CODEGRAPH_PARSER_MAX_SYNTAX_DEPTH=4096
CODEGRAPH_PARSER_MAX_IR_RECORDS=100000
CODEGRAPH_PARSER_MAX_DIAGNOSTICS=100
CODEGRAPH_PARSER_MAX_OUTPUT_BYTES=33554432

# Embeddings: when a model and key are set, every run embeds changed documents
# after publishing and search becomes hybrid (semantic + lexical) on the
# Spanner vector index. DIMENSIONS fixes the length of the embedding column
# and its vector index when the database is created (0 means 3072, the
# provider default); every process must use the database's value, and
# changing it means a new database. Whatever searches the graph must embed
# queries with the same model, so the model, dimensions and gateway are the
# ones every app shares, FORGE_EMBEDDING_* in .env.common, as is the key.
# Empty model: no embeddings, and search stays lexical.
OPENAI_API_KEY=${OPENAI_API_KEY}
CODEGRAPH_EMBEDDING_MODEL=${FORGE_EMBEDDING_MODEL}
CODEGRAPH_EMBEDDING_DIMENSIONS=${FORGE_EMBEDDING_DIMENSIONS}
CODEGRAPH_EMBEDDING_BASE_URL=${FORGE_EMBEDDING_BASE_URL}
# Embedding requests in flight after publication; each carries up to 16
# documents. The worker logs one line per page of documents embedded.
CODEGRAPH_EMBEDDING_CONCURRENCY=8

# Search: lexical retrieval runs on the Spanner search index and needs no
# embeddings. Query enhancement (spelling, synonyms, plurals, IDF scoring) is a
# managed-Spanner feature; turn it on in production. The emulator ignores it.
CODEGRAPH_SEARCH_ENHANCE_QUERY=false
