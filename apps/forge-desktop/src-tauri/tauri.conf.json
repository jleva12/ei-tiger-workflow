{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge Agents",
  "version": "0.1.0",
  "identifier": "dev.forge.agents",
  "build": {
    "beforeDevCommand": "npm --prefix ../forge-web run dev:desktop",
    "devUrl": "http://localhost:5195",
    "beforeBuildCommand": "npm --prefix ../forge-web run build:desktop",
    "frontendDist": "../../forge-web/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forge Agents",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "url": "desktop.html",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Chat with your organization's Forge agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "forge-agents"
        ]
      }
    }
  }
}
