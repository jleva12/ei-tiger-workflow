# forge-codegraph-mcp configuration. make env copies this to .env; keep real
# keys out of this template. Precedence, lowest to highest: built-in
# defaults, .env in the working directory, the process environment. Every
# setting is CODEGRAPH_ plus its path, nested groups joined with __
# (core/settings.py). Values the server shares with the code graph worker
# (the cursor key, the embedding model and dimensions, the OpenAI key) come
# from the repository's .env.common, which make env creates, by ${NAME}
# reference: an earlier line of this file wins, and only the names referenced
# here are read. Compose resolves the references, passes this file to the
# container and points it at the worker's database.

# The HTTP server: the MCP endpoint at CODEGRAPH_MCP__PATH, beside
# /health/live and /health/ready. Compose listens on 0.0.0.0:8103 and
# publishes CODEGRAPH_MCP_PORT (18203).
CODEGRAPH_SERVER__HOST=127.0.0.1
CODEGRAPH_SERVER__PORT=8103
CODEGRAPH_SERVER__RELOAD=false
CODEGRAPH_MCP__PATH=/mcp

# Logging: level DEBUG, INFO, WARNING or ERROR; format json or console
# (unset: console on a terminal, json otherwise).
CODEGRAPH_LOGGING__LEVEL=INFO

# Who may call the MCP endpoint, and what they read (access.py): callers
# send an organization's API key (fk_…) or a Forge token minted for an
# organization (forge-admin-token --organization), which the admin API checks
# (GET <ADMIN_URL>/code-graph/access); each reads only its organization's
# code repositories. ADMIN_URL is the admin API with its prefix, as make
# admin serves it; Compose points at the admin service. ADMIN_API_KEY is the
# admin's deployment key (its FORGE_ADMIN_API_KEY), sent with each check when
# it has one: make env copies it. Answers are kept per credential for
# CACHE_SECONDS.
CODEGRAPH_MCP__AUTH__ADMIN_URL=http://localhost:8101/api/v1
CODEGRAPH_MCP__AUTH__ADMIN_API_KEY=
CODEGRAPH_MCP__AUTH__CACHE_SECONDS=60

# The graph: the code graph worker's Spanner database and scope
# (apps/forge-codegraph-worker), read only. make codegraph-mcp points the
# server at the emulator (SPANNER_EMULATOR_HOST) the worker provisions; the
# database must exist, so start the worker first. Cursors are signed with the
# worker's key, at least 32 characters.
CODEGRAPH_SPANNER__DATABASE=projects/codegraph-local/instances/codegraph/databases/codegraph
CODEGRAPH_SPANNER__SCOPE=codegraph
CODEGRAPH_SPANNER__CURSOR_SIGNING_KEY=${FORGE_CODEGRAPH_CURSOR_SIGNING_KEY}

# Embeddings: with a model and an API key, explore_code and search_code add
# the semantic branch on the database's vector index, questions embedded as
# the worker embedded the graph; without them, search is lexical. The model,
# dimensions and gateway are the ones every app shares (FORGE_EMBEDDING_* in
# .env.common), and startup checks the database's vector length against the
# dimensions.
CODEGRAPH_EMBEDDING__MODEL=${FORGE_EMBEDDING_MODEL}
CODEGRAPH_EMBEDDING__DIMENSIONS=${FORGE_EMBEDDING_DIMENSIONS}
CODEGRAPH_EMBEDDING__BASE_URL=${FORGE_EMBEDDING_BASE_URL}
CODEGRAPH_EMBEDDING__API_KEY=${OPENAI_API_KEY}

# Spanner's query enhancement (spelling, synonyms, plurals, IDF scoring) is a
# managed-Spanner feature; turn it on there. The emulator ignores it.
CODEGRAPH_SEARCH__ENHANCE_QUERY=false
