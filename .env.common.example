# Settings several apps share, in one place. make env copies this to
# .env.common (git-ignored); keep real credentials out of this template.
#
# Nothing here reaches an app by itself. An app's .env names each shared value
# it needs with a ${NAME} reference, e.g. in apps/forge-async-worker/.env:
#   HYBRID_REDIS_URL=${FORGE_REDIS_URL}
# so an app never receives a shared value it does not reference. Native runs
# resolve the references when they read their .env; Compose resolves them from
# this file, which the root Makefile passes with --env-file. A reference to a
# name defined nowhere stops the app at startup. Values here may reference
# earlier lines of this file. Keep URL-safe characters in values that apps
# build URLs from (the MySQL and MongoDB users and passwords).

# The admin API's MySQL (admin-mysql, which make admin-deps publishes on
# 127.0.0.1:13326, ADMIN_MYSQL_PORT): organizations, users, roles,
# permissions, the assistant's conversations, and ADK workflow runs and their
# sessions.
# Compose points the container at admin-mysql itself, with the ADMIN_MYSQL_*
# settings of .env.compose.
FORGE_MYSQL_HOST=127.0.0.1
FORGE_MYSQL_PORT=13326
FORGE_MYSQL_DATABASE=forge_admin
FORGE_MYSQL_USER=forge_admin
FORGE_MYSQL_PASSWORD=local-admin

# Shared MongoDB (Atlas Local) and Redis. Ports apply to native connections
# and Compose; MongoDB credentials authenticate against admin. Use URI-safe
# values. The admin API keeps ADK workflows in MongoDB.
FORGE_MONGO_USER=forge
FORGE_MONGO_PASSWORD=local-forge
FORGE_MONGO_PORT=27037
FORGE_MONGO_URI=mongodb://${FORGE_MONGO_USER}:${FORGE_MONGO_PASSWORD}@127.0.0.1:${FORGE_MONGO_PORT}/?authSource=admin&directConnection=true
FORGE_REDIS_PORT=16389
# The async worker's SAQ queue (adk_workflows), database 0: the admin API
# queues ADK workflow runs there and the worker serves them.
FORGE_REDIS_URL=redis://127.0.0.1:${FORGE_REDIS_PORT}/0

# Knowledge bases. Uploaded documents are stored in S3: locally the RustFS in
# compose.infrastructure.yaml (knowledge-s3), whose bucket the admin API
# makes on first use. The async worker reads them back and embeds their
# chunks (with the embedding model below) into this database of the shared
# MongoDB, where the admin API and chat agents' knowledge base tools search
# them.
FORGE_S3_PORT=19010
FORGE_S3_ENDPOINT_URL=http://127.0.0.1:${FORGE_S3_PORT}
FORGE_S3_ACCESS_KEY_ID=forge-local
FORGE_S3_SECRET_ACCESS_KEY=local-forge-secret
FORGE_DOCUMENTS_BUCKET=forge-knowledge
FORGE_KNOWLEDGE_DATABASE=forge_knowledge

# Workflow runs' files: a workflow whose start allows files is run with them,
# and the admin API saves each as an ADK artifact of the run's session here,
# where the async worker's runs read them. Locally the same RustFS, in a
# bucket the admin API makes on first use.
FORGE_WORKFLOW_ARTIFACTS=s3://forge-artifacts/workflows

# The code graph: the ingestion worker (apps/forge-codegraph-worker) parses
# GitHub repositories into a graph of their code in Spanner (locally the
# emulator, worker-spanner), embedding its declarations with the embedding
# model below. Callers submit ingestions to its admission API with the
# admission token, and every reader of the graph signs pagination cursors
# with the cursor key; both are at least 32 characters, and make env
# generates them.
FORGE_CODEGRAPH_ADMISSION_TOKEN=
FORGE_CODEGRAPH_CURSOR_SIGNING_KEY=
# The token every clone and fetch of the code graph worker sends to GitHub:
# a fine-grained personal access token with read access to the contents of
# the repositories to ingest. Empty reads GitHub anonymously, which ingests
# public repositories only.
FORGE_GITHUB_TOKEN=

# Embeddings: the one model, and vector length, everything embeds with. The
# async worker embeds knowledge base chunks with it and the admin API embeds
# knowledge base searches; the code graph worker embeds the graph and its MCP
# server embeds questions about it. Each app's .env names these by
# reference, so they can't disagree: a question embedded with another model
# or length matches nothing. An OpenAI model, with OPENAI_API_KEY;
# FORGE_EMBEDDING_BASE_URL is an OpenAI-compatible gateway, empty for OpenAI.
# Changing the model or dimensions means embedding everything again: a new
# code graph database (its vector column's length is fixed when it's created)
# and every knowledge base document, into a chunks vector index rebuilt for
# the new length (the worker only logs that an existing index differs).
FORGE_EMBEDDING_MODEL=text-embedding-3-large
FORGE_EMBEDDING_DIMENSIONS=1024
FORGE_EMBEDDING_BASE_URL=

# Model providers. Gemini (https://aistudio.google.com/apikey) runs the
# admin API's assistant and ADK workflows' LLM nodes by default. OpenAI and
# Anthropic are used only when an app's .env names the shared model-provider
# YAML (packages/python/common/src/forge_common/model_provider) and
# references these keys.
FORGE_GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
