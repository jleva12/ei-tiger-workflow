{
  "groups": [
    { "id": "start", "label": "Start" },
    { "id": "agents", "label": "Agents" },
    { "id": "people", "label": "People" },
    { "id": "actions", "label": "Actions" },
    { "id": "github", "label": "GitHub" },
    { "id": "logic", "label": "Logic" },
    { "id": "finish", "label": "Finish" }
  ],
  "kinds": [
    {
      "kind": "start",
      "label": "Start",
      "group": "start",
      "icon": "play",
      "summary": "Where every run starts: what the person or system sends in.",
      "keywords": "start input begin entry",
      "id_prefix": "start",
      "terminal": true,
      "outputs": [{ "id": "next", "label": "Next" }],
      "defaults": {
        "input_schema": {},
        "allow_files": false,
        "file_types": [],
        "allow_file_system": false,
        "start_over": false
      }
    },
    {
      "kind": "llm",
      "label": "LLM agent",
      "group": "agents",
      "icon": "robot-01",
      "summary": "A model works on what comes in with your instruction, and can hand off to its sub-agents.",
      "keywords": "llm ai model agent prompt instruction gemini delegate transfer",
      "id_prefix": "agent",
      "orb": 0,
      "outputs": [{ "id": "next", "label": "Next" }],
      "defaults": {
        "description": "",
        "instruction": "",
        "model": { "provider": "", "name": "" },
        "thinking_level": "",
        "output_schema": {},
        "include_contents": "default",
        "disallow_transfer_to_parent": false,
        "disallow_transfer_to_peers": false,
        "max_output_tokens": null,
        "sub_agents": [],
        "tools": [],
        "mode": "single_turn",
        "source": "inline",
        "agent": "",
        "version": null,
        "message": "",
        "inputs": {}
      }
    },
    {
      "kind": "sequential",
      "label": "Sequential agent",
      "group": "agents",
      "icon": "left-to-right-list-number",
      "summary": "Runs its sub-agents one after another, each seeing what the last did.",
      "keywords": "sequence pipeline chain steps order team",
      "id_prefix": "sequential",
      "outputs": [{ "id": "next", "label": "Next" }],
      "defaults": { "description": "", "sub_agents": [] }
    },
    {
      "kind": "parallel",
      "label": "Parallel agent",
      "group": "agents",
      "icon": "distribution",
      "summary": "Runs its sub-agents at the same time, each on its own.",
      "keywords": "parallel concurrent fan out together team",
      "id_prefix": "parallel",
      "outputs": [{ "id": "next", "label": "Next" }],
      "defaults": { "description": "", "sub_agents": [] }
    },
    {
      "kind": "loop_agent",
      "label": "Loop agent",
      "group": "agents",
      "icon": "repeat",
      "summary": "Runs its sub-agents in order, again and again, up to a number of passes.",
      "keywords": "loop repeat iterate refine critique team agent",
      "id_prefix": "loop_agent",
      "outputs": [{ "id": "next", "label": "Next" }],
      "defaults": { "description": "", "sub_agents": [], "max_iterations": 3 }
    },
    {
      "kind": "saved",
      "label": "Saved workflow",
      "group": "agents",
      "icon": "flow-square",
      "summary": "Runs another of the organization's workflows here, whole.",
      "keywords": "saved nested reuse subgraph workflow compose other agent",
      "id_prefix": "saved",
      "outputs": [{ "id": "next", "label": "Next" }],
      "defaults": { "agent": "", "version": null, "inputs": {} }
    },
    {
      "kind": "pi_agent",
      "label": "Pi agent",
      "group": "agents",
      "icon": "ai-programming",
      "summary": "Pi, a coding agent, works in a folder of the run's: reads, searches and, if allowed, runs commands and changes files.",
      "keywords": "pi coding agent code explore repository files folder bash shell git clone grep",
      "id_prefix": "pi",
      "outputs": [{ "id": "next", "label": "Next" }],
      "defaults": {
        "folder": "",
        "prompt": "",
        "instruction": "",
        "tools": ["read", "grep", "find", "ls"],
        "model": { "provider": "", "name": "" },
        "thinking_level": "",
        "output_schema": {},
        "context_files": false,
        "timeout_seconds": 600
      }
    },
    {
      "kind": "approval",
      "label": "Approval",
      "group": "people",
      "icon": "user-check-01",
      "summary": "The run waits for a person to approve or reject.",
      "keywords": "human review person approve reject handoff sign off",
      "id_prefix": "approval",
      "person": true,
      "outputs": [
        { "id": "approved", "label": "Approved", "branch": true },
        { "id": "rejected", "label": "Rejected", "branch": true, "fallback": true }
      ],
      "defaults": { "message": "", "approvers": "org:admin", "timeout_hours": 0 }
    },
    {
      "kind": "human_input",
      "label": "Human input",
      "group": "people",
      "icon": "user-question-01",
      "summary": "Pauses for a person to answer; their answer is what it hands on.",
      "keywords": "human person input ask question approve pause review",
      "id_prefix": "human_input",
      "person": true,
      "outputs": [{ "id": "next", "label": "Next" }],
      "defaults": { "message": "", "response_schema": {} }
    },
    {
      "kind": "http",
