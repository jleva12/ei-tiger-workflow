        { "id": "success", "label": "Success", "branch": true },
        { "id": "error", "label": "Error", "branch": true, "fallback": true }
      ],
      "defaults": {
        "folder": "",
        "message": "",
        "author_name": "",
        "author_email": "",
        "credential": "",
        "timeout_seconds": 300
      }
    },
    {
      "kind": "github_pull_request",
      "label": "Open pull request",
      "group": "github",
      "icon": "git-pull-request-create",
