      "defaults": {
        "method": "GET",
        "url": "",
        "query": [],
        "headers": [],
        "body": "",
        "timeout_seconds": 30,
        "retries": 0,
        "output_schema": {},
        "credential": ""
      }
    },
    {
      "kind": "bash",
      "label": "Bash",
      "group": "actions",
      "icon": "command-line",
      "summary": "Runs a shell command in the run's folder and hands on its output.",
      "keywords": "bash shell command terminal script cli run git gh clone repository npm make",
      "id_prefix": "bash",
      "outputs": [
        { "id": "success", "label": "Success", "branch": true },
        { "id": "error", "label": "Error", "branch": true, "fallback": true }
      ],
      "defaults": { "command": "", "cwd": "", "env": [], "timeout_seconds": 300 }
    },
    {
      "kind": "transform",
      "label": "Transform",
      "group": "actions",
      "icon": "function",
      "summary": "Reshapes data with a JSONata expression.",
      "keywords": "map reshape jsonata expression object data",
      "id_prefix": "transform",
      "outputs": [{ "id": "next", "label": "Next" }],
      "defaults": { "expression": "", "output_schema": {} }
    },
    {
      "kind": "filter",
      "label": "Filter",
      "group": "actions",
      "icon": "filter",
      "summary": "Keeps the items of a list its condition holds for.",
