      "id_prefix": "pull_request",
      "outputs": [
        { "id": "success", "label": "Success", "branch": true },
        { "id": "error", "label": "Error", "branch": true, "fallback": true }
      ],
      "defaults": {
        "repository": "",
        "head": "",
        "base": "",
        "title": "",
        "body": "",
        "draft": false,
        "credential": "",
        "timeout_seconds": 30
      }
    },
    {
      "kind": "if",
      "label": "If / else",
      "group": "logic",
      "icon": "git-fork",
      "summary": "Takes one of two ways, on a condition.",
      "keywords": "condition branch boolean true false",
      "id_prefix": "if",
      "outputs": [
        { "id": "true", "label": "True", "branch": true },
        { "id": "false", "label": "False", "branch": true, "fallback": true }
      ],
      "defaults": { "condition": "" }
    },
    {
      "kind": "switch",
      "label": "Switch",
      "group": "logic",
      "icon": "route-02",
      "summary": "Routes on one value: to the case it equals.",
      "keywords": "case value equals enum route branch",
      "id_prefix": "switch",
      "rows": { "setting": "cases", "label": "value", "empty": "Empty value" },
      "outputs": [{ "id": "default", "label": "Default", "branch": true, "fallback": true }],
      "defaults": {
        "value": "",
        "cases": [
          { "id": "case_1", "value": "" },
          { "id": "case_2", "value": "" }
        ]
      }
    },
    {
      "kind": "match",
      "label": "Match",
      "group": "logic",
      "icon": "left-to-right-list-bullet",
      "summary": "Routes to the first rule whose condition holds, or to every one.",
      "keywords": "pattern rules guard first condition route all every fan out",
      "id_prefix": "match",
      "rows": { "setting": "arms", "label": "label", "empty": "Rule {n}" },
      "outputs": [{ "id": "otherwise", "label": "Otherwise", "branch": true, "fallback": true }],
      "defaults": {
        "arms": [
          { "id": "rule_1", "label": "", "condition": "" },
          { "id": "rule_2", "label": "", "condition": "" }
        ],
        "mode": "first"
      }
    },
    {
      "kind": "loop",
      "label": "Loop",
      "group": "logic",
      "icon": "repeat",
      "summary": "Runs its body once for each item in a list, collecting what each hands back.",
      "keywords": "for each iterate repeat list items collect results map",
      "id_prefix": "loop",
      "outputs": [
        { "id": "each", "label": "Each item", "branch": true, "body": true },
        { "id": "done", "label": "Done", "branch": true }
      ],
      "defaults": { "items": "", "item_name": "item", "max_iterations": 100, "concurrency": 1 }
    },
    {
      "kind": "for_each",
      "label": "For each",
      "group": "logic",
      "icon": "arrow-right-double",
      "summary": "Runs its steps once for each item in a list; nothing comes back to it.",
      "keywords": "for each foreach iterate list items every fan out process",
      "id_prefix": "for_each",
      "outputs": [
        { "id": "each", "label": "Each item", "branch": true, "body": true },
        { "id": "done", "label": "Done", "branch": true }
      ],
      "defaults": { "items": "", "item_name": "item", "max_iterations": 100, "concurrency": 1 }
    },
    {
      "kind": "merge",
      "label": "Merge",
      "group": "logic",
      "icon": "git-merge",
      "summary": "Waits for the ways coming into it, then goes on as one.",
      "keywords": "join wait parallel combine",
      "id_prefix": "merge",
      "outputs": [{ "id": "next", "label": "Next" }],
      "defaults": { "mode": "all" }
    },
    {
      "kind": "end",
      "label": "End",
      "group": "finish",
      "icon": "flag-02",
      "summary": "Finishes the run, as succeeded or failed, with a result.",
      "keywords": "finish stop return result output fail",
      "id_prefix": "end",
      "terminal": true,
      "outputs": [],
      "defaults": { "outcome": "succeeded", "result": "" }
    }
  ]
}
