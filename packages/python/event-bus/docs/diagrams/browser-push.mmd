sequenceDiagram
    participant Browser as Browser Client
    participant Endpoint as SSE/WS Endpoint
    participant Adapter as SSE/WS Subscriber
    participant PubSub as Redis Pub/Sub
    participant Bus as EventBus

    Browser->>Endpoint: GET /events/stream?topics=orders.*
    Endpoint->>Adapter: SSESubscriber(["orders.*"], transport)
    Adapter->>PubSub: PSUBSCRIBE eventbus:channel:orders.*

    loop Event Stream
        Bus->>PubSub: PUBLISH eventbus:channel:orders.created
        PubSub-->>Adapter: event envelope
        Adapter->>Adapter: format as SSE
        Adapter-->>Browser: id: evt-123<br/>event: orders.created<br/>data: {"order_id": "456"}
    end

    loop Heartbeat (every 15s)
        Adapter-->>Browser: : heartbeat
    end

    Browser->>Endpoint: Connection closed
    Endpoint->>Adapter: stop()
    Adapter->>PubSub: PUNSUBSCRIBE
