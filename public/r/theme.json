    },
    "@utility orb-agent-4": {
      "background": "radial-gradient(at 18% 14%, #c7ffff 0, transparent 50%), conic-gradient(from 60deg, #f0b892, #e1a3e9, #7f8df5, #7ce7e0, #f0b892)",
      "filter": "hue-rotate(130deg)"
    },
    "@utility scrollbar-dark": {
      "color-scheme": "dark",
      "--scrollbar-thumb": "oklch(0.51 0.012 260)",
      "--scrollbar-thumb-hover": "oklch(0.64 0.012 260)",
      "--scrollbar-thumb-active": "oklch(0.73 0.012 260)"
    },
    "@utility shimmer": {
      "background-image": "linear-gradient(\n        90deg,\n        currentColor 35%,\n        color-mix(in oklab, currentColor 30%, transparent) 50%,\n        currentColor 65%\n    )",
      "background-size": "250% 100%",
      "background-clip": "text",
      "-webkit-text-fill-color": "transparent",
      "animation": "shimmer 2.2s linear infinite"
    },
    "@keyframes shimmer": {
      "from": {
        "background-position": "100% 0"
      },
      "to": {
        "background-position": "0 0"
      }
    },
    "@keyframes collapsible-down": {
      "from": {
        "height": "0"
      },
      "to": {
        "height": "var(\n            --radix-collapsible-content-height,\n            var(--collapsible-panel-height, auto)\n        )"
      }
    },
    "@keyframes collapsible-up": {
      "from": {
        "height": "var(\n            --radix-collapsible-content-height,\n            var(--collapsible-panel-height, auto)\n        )"
      },
      "to": {
        "height": "0"
      }
    },
    ":where(button, a, input, textarea, select, [tabindex=\"0\"])": {
      "outline-offset": "3px"
    },
    ":where(button, a, [tabindex=\"0\"]):focus-visible": {
      "outline": "2px solid var(--focus)"
    },
    "@media (forced-colors: none)": {
      "*": {
        "scrollbar-width": "thin",
        "scrollbar-color": "var(--scrollbar-thumb) transparent"
      },
      "@supports selector(::-webkit-scrollbar)": {
        "*": {
          "scrollbar-width": "auto",
          "scrollbar-color": "auto"
        },
        "*::-webkit-scrollbar": {
          "width": "var(--scrollbar-size)",
          "height": "var(--scrollbar-size)"
        },
        "*::-webkit-scrollbar-track,\n        *::-webkit-scrollbar-corner": {
          "background": "transparent"
        },
        "*::-webkit-scrollbar-thumb": {
          "min-height": "32px",
          "min-width": "32px",
          "border": "2px solid transparent",
          "border-radius": "999px",
          "background": "var(--scrollbar-thumb)",
          "background-clip": "padding-box"
        },
        "*::-webkit-scrollbar-thumb:hover": {
          "background-color": "var(--scrollbar-thumb-hover)"
        },
        "*::-webkit-scrollbar-thumb:active": {
          "background-color": "var(--scrollbar-thumb-active)"
        },
        "*::-webkit-scrollbar-button": {
          "display": "none"
        }
      }
    },
    "@media (prefers-reduced-motion: reduce)": {
      "*, *::before, *::after": {
        "animation-duration": ".01ms !important",
        "animation-iteration-count": "1 !important",
        "transition-duration": ".01ms !important",
        "scroll-behavior": "auto !important"
      }
    },
    ":root[data-forge-motion=\"reduce\"] *,\n:root[data-forge-motion=\"reduce\"] *::before,\n:root[data-forge-motion=\"reduce\"] *::after": {
      "animation-duration": ".01ms !important",
      "animation-iteration-count": "1 !important",
      "transition-duration": ".01ms !important",
      "scroll-behavior": "auto !important"
    },
    ":root[data-forge-density=\"compact\"]": {
      "--spacing": "0.21875rem",
      "--forge-row-height": "34px"
    },
    ":root[data-forge-contrast=\"more\"]": {
      "--muted-foreground": "oklch(0.42 0.014 260)",
      "--subtle": "oklch(0.5 0.012 260)",
      "--nav-foreground": "oklch(0.32 0.012 260)",
      "--border": "oklch(0.82 0.006 260)",
      "--input": "oklch(0.8 0.006 260)"
    },
    ":root.dark[data-forge-contrast=\"more\"]": {
      "--muted-foreground": "oklch(0.8 0.009 260)",
      "--subtle": "oklch(0.72 0.01 260)",
      "--nav-foreground": "oklch(0.82 0.009 260)",
      "--border": "oklch(0.42 0.008 260)",
      "--input": "oklch(0.44 0.008 260)"
    },
    "@media (prefers-contrast: more)": {
      ":root[data-forge-contrast=\"system\"]": {
        "--muted-foreground": "oklch(0.42 0.014 260)",
        "--subtle": "oklch(0.5 0.012 260)",
        "--nav-foreground": "oklch(0.32 0.012 260)",
        "--border": "oklch(0.82 0.006 260)",
        "--input": "oklch(0.8 0.006 260)"
      },
      ":root.dark[data-forge-contrast=\"system\"]": {
        "--muted-foreground": "oklch(0.8 0.009 260)",
        "--subtle": "oklch(0.72 0.01 260)",
        "--nav-foreground": "oklch(0.82 0.009 260)",
        "--border": "oklch(0.42 0.008 260)",
        "--input": "oklch(0.44 0.008 260)"
      }
    }
  },
  "type": "registry:theme"
}